      container.style.maxWidth = '300px';
      container.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';

      //title
      const title = document.createElement('h2');
      title.innerText = 'You drew a playable card!';
      title.style.marginBottom = '10px';
      title.style.color = 'var(--text-color, white)';
      container.appendChild(title);

      //show card
      const cardPreview = document.createElement('div');
      cardPreview.className = 'card';
      cardPreview.dataset.cardId = fixCardId(card.id);
      cardPreview.style.margin = '0 auto 20px auto';
      cardPreview.style.transform = 'scale(1.2)';
      container.appendChild(cardPreview);

      //buttons container
      const btnContainer = document.createElement('div');
      btnContainer.style.display = 'flex';
      btnContainer.style.justifyContent = 'center';
      btnContainer.style.gap = '12px';

      //Play button
      const playBtn = document.createElement('button');
      playBtn.innerText = 'Play It';
      playBtn.className = 'btn';
      playBtn.style.padding = '12px 24px';
      playBtn.style.background = '#4CAF50';
      playBtn.style.color = 'white';
      playBtn.style.border = 'none';
      playBtn.style.borderRadius = '8px';
      playBtn.style.cursor = 'pointer';
      playBtn.addEventListener('click', () => {
        overlay.remove();
        if (isWild) {
          showColorPicker((chosenColor) => {
            callback('play', chosenColor);
          }, 'Choose color for Wild card');
        } else {
          callback('play', null);
        }
      });
      btnContainer.appendChild(playBtn);

      //keep button
      const keepBtn = document.createElement('button');
      keepBtn.innerText = 'Keep It';
      keepBtn.className = 'btn';
      keepBtn.style.padding = '12px 24px';
      keepBtn.style.background = '#2196F3';
      keepBtn.style.color = 'white';
      keepBtn.style.fontSize = '16px';
      keepBtn.style.border = 'none';
      keepBtn.style.borderRadius = '8px';
      keepBtn.style.cursor = 'pointer';
      keepBtn.addEventListener('click', () => {
        overlay.remove();
        callback('keep', null);
      });
      btnContainer.appendChild(keepBtn);

      container.appendChild(btnContainer);
