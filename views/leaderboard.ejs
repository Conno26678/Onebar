<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Leaderboard</title>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
    <a href="/logout" class="btn logout-button">Logout</a>
    <a href="/" class="back-link">Back to Home</a>
    <h1>Leaderboard Page</h1>
    <table>
        <thead>
            <tr>
                <th>Rank</th>
                <th>Username</th>
                <th>Wins</th>
                <th>Games Played</th>
            </tr>
        </thead>
        <tbody>
            <% leaderboard.forEach((user, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= user.username %></td>
                    <td><%= user.wins %></td>
                    <td><%= user.losses %></td>
                     <td><%= ((user.wins / user.gamesPlayed) * 100).toFixed(1) %>%</td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<script src="/js/theme.js"></script>
</body>
</html>