<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#f85149">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <title>Onebar - Profile</title>
    <link rel="icon" type="image/x-icon" href="/img/pfp.png">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <style>
        /* ── Effect Preview Particle Styles ── */
        .preview-confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            top: -10px;
            opacity: 1;
            pointer-events: none;
            z-index: 99999;
            animation: previewConfettiFall linear forwards;
        }
        @keyframes previewConfettiFall {
            0%   { transform: translateY(0) rotateZ(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotateZ(720deg); opacity: 0; }
        }

        .preview-sparkle {
            position: fixed;
            width: 10px;
            height: 10px;
            background: radial-gradient(circle, #fff 0%, #ffd700 50%, transparent 100%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 99999;
            animation: previewSparkleFloat linear forwards;
        }
        @keyframes previewSparkleFloat {
            0%   { opacity: 1; transform: translate(0,0) scale(1); }
            100% { opacity: 0; transform: translate(var(--sx), var(--sy)) scale(0.2); }
        }

        .preview-fire {
            position: fixed;
            border-radius: 50% 50% 40% 40% / 60% 60% 40% 40%;
            background: radial-gradient(ellipse at bottom, rgba(255,100,0,1) 0%, rgba(255,200,0,.9) 30%, rgba(255,100,0,.5) 60%, transparent 100%);
            pointer-events: none;
            z-index: 99999;
            animation: previewFireRise linear forwards;
        }
        @keyframes previewFireRise {
            0%   { opacity: 1; transform: translate(0,0) scale(1); }
            50%  { opacity: .8; transform: translate(var(--fx), calc(var(--fy)*.5)) scale(1.2); }
            100% { opacity: 0; transform: translate(var(--fx), var(--fy)) scale(.4); }
        }

        .preview-skip {
            position: fixed;
            width: 180px;
            height: 180px;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%) scale(0);
            pointer-events: none;
            z-index: 99999;
            animation: previewSkipPop 1.2s ease-out forwards;
        }
        .preview-skip::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border: 18px solid #ff0000;
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(255,0,0,.8), 0 0 60px rgba(255,0,0,.4), inset 0 0 20px rgba(255,0,0,.3);
        }
        .preview-skip::after {
            content: '';
            position: absolute;
            width: calc(100% - 36px);
            height: 18px;
            background: #ff0000;
            top: calc(50% - 9px);
            left: 18px;
            border-radius: 9px;
            box-shadow: 0 0 20px rgba(255,0,0,.8);
        }
        @keyframes previewSkipPop {
            0%   { transform: translate(-50%,-50%) scale(0); opacity: 1; }
            30%  { transform: translate(-50%,-50%) scale(1.15); opacity: 1; }
            50%  { transform: translate(-50%,-50%) scale(1); opacity: 1; }
            80%  { transform: translate(-50%,-50%) scale(1); opacity: 1; }
            100% { transform: translate(-50%,-50%) scale(1.2); opacity: 0; }
        }

        .preview-lightning-bolt {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 99999;
        }
        .preview-lightning-bolt svg {
            filter: drop-shadow(0 0 15px rgba(150,200,255,1)) drop-shadow(0 0 30px rgba(100,150,255,.8));
            animation: previewLightningPulse .6s ease-out forwards;
        }
        @keyframes previewLightningPulse {
            0%   { opacity: 0; }
            15%  { opacity: 1; }
            100% { opacity: 0; }
        }
        .preview-lightning-flash {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(255,255,255,.45);
            pointer-events: none;
            z-index: 99998;
            animation: previewFlash .5s ease-out forwards;
        }
        @keyframes previewFlash {
            0%   { opacity: 0; }
            10%  { opacity: .8; }
            100% { opacity: 0; }
        }

        .preview-arrow {
            position: fixed;
            width: 80px;
            height: 4px;
            background: linear-gradient(to right, #8B4513 0%, #D2691E 60%, #FFD700 100%);
            box-shadow: 0 0 10px rgba(255,215,0,.6);
            pointer-events: none;
            z-index: 99999;
            transform-origin: left center;
            animation: previewArrowFall .9s ease-in forwards;
        }
        .preview-arrow::before {
            content: '';
            position: absolute;
            right: -10px; top: -6px;
            border-left: 15px solid #FFD700;
            border-top: 7px solid transparent;
            border-bottom: 7px solid transparent;
        }
        .preview-arrow::after {
            content: '';
            position: absolute;
            left: 0; top: -3px;
            width: 15px; height: 10px;
            background: #8B4513;
            border-radius: 0 5px 5px 0;
        }
        @keyframes previewArrowFall {
            0%   { transform: rotate(90deg) translateY(0); opacity: 1; }
            100% { transform: rotate(90deg) translateY(115vh); opacity: .1; }
        }

        /* Preview button style */
        .effect-preview-btn {
            padding: 6px 14px;
            font-size: 0.78rem;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
            color: #fff;
            transition: all .2s ease;
            box-shadow: 0 2px 8px rgba(99,102,241,.4);
            margin-top: 4px;
        }
        .effect-preview-btn:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(99,102,241,.6);
        }
    </style>
</head>
<body>
    <a href="/" class="btn home-button">Home</a>
    <a href="/logout" class="btn logout-button">Logout</a>

    <div class="profile-container">
        <div class="profile-header">
            <h1>
                <%= user.displayName %>
                <% if (selectedBadge && selectedBadge !== 'none') { %>
                    <% 
                        const badgeEmojis = {
                            'bronze': '🥉',
                            'silver': '🥈',
                            'gold': '🥇',
                            'trophy': '🏆',
                            'diamond': '💎'
                        };
                        const badgeEmoji = badgeEmojis[selectedBadge] || '';
                    %>
                    <span class="profile-user-badge"><%= badgeEmoji %></span>
                <% } %>
                 Profile
            </h1>
            <p class="profile-subtitle">Your stats and customization options</p>
        </div>

        <div class="profile-content">
            <!-- Profile Image Section -->
            <div class="profile-image-section">
                <div class="profile-image-container">
                    <div class="profile-image-wrapper">
                        <img src="<%= profilePicture || '/img/pfp.png' %>" alt="User Photo" class="profile-image" 
                             onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'profile-image-placeholder\'>👤</div>';" />
                        <% if (isFirstPlace) { %>
                            <div class="first-place-badge" title="You are #1 on the leaderboard!">
                            </div>
                        <% } %>
                    </div>
                </div>
                <button class="change-photo-btn" onclick="showPhotoChange()">Change Photo</button>
                <!--PFP Popup Modal -->
                <div id="customizePhoto" class="customize-photo-popup" style="display: none;">
                    <div class="customize-photo-popup-content">
                        <span class="customize-popup-close" onclick="hidePhotoChange()">&times;</span>
                        <h2>Select Profile Picture</h2>
                        <p class="photo-subtitle">Unlock new avatars through Battle Pass and achievements</p>
                        <div class="photo-options-grid" id="photoOptionsGrid">
                            <!-- Photos will be dynamically loaded here -->
                        </div>
                    </div>
                </div>

                <% if (isFirstPlace) { %>
                    <p class="image-caption" style="color: #ffd700; font-weight: bold;"> Leaderboard Champion!</p>
                <% } else { %>
                    <p class="image-caption">This you bro?</p>
                <% } %>
                
                <!-- Customize Card Button -->
                <div class="customize-card-section">
                    <div class="card-back-preview">
                        <img src="/img/cards/card_Back.png" alt="Card Back" class="card-back-img">
                    </div>
                    <button class="customize-card-btn" onclick="showCustomizePopup()">Customize Options</button>
                </div>
                
                <!-- Customize Options Popup Modal -->
                <div id="customizePopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideCustomizePopup()">&times;</span>
                        <h2>Options - earn more by leveling up</h2>
                        <div class="customize-options-grid">
                            <div class="customize-option">
                                <h3>Titles</h3>
                                <p>Unlock new titles and title colors through Battle Pass</p>
                                <button class="customize-option-btn" onclick="showTitlePopup()">Customize</button>
                            </div>
                            <div class="customize-option">
                                <h3>Themes</h3>
                                <p>Customize your game / website appearance</p>
                                <button class="customize-option-btn" onclick="showThemePopup()">Customize</button>
                            </div>
                            <div class="customize-option">
                                <h3>Sound Packs</h3>
                                <p>Unlock exclusive sound effects</p>
                                <button class="customize-option-btn" onclick="showSoundPackPopup()">Customize</button>
                            </div>
                            <div class="customize-option">
                                <h3>Profile Badges</h3>
                                <p>Show off your achievements</p>
                                <button class="customize-option-btn" onclick="showBadgePopup()">Customize</button>
                            </div>
                            <div class="customize-option">
                                <h3>Effects</h3>
                                <p>Liven up your gameplay with special effects</p>
                                <button class="customize-option-btn" onclick="showEffectsPopup()">Customize</button>
                            </div>
                            <div class="customize-option">
                                <h3>Emotes</h3>
                                <p>Express yourself in-game</p>
                                <button class="customize-option-btn" onclick="showEmotePopup()">Customize</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Title Customization Popup -->
                <div id="titlePopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideTitlePopup()">&times;</span>
                        <h2>Select Your Title</h2>
                        <p class="photo-subtitle">Unlock new titles through Battle Pass</p>
                        <div class="customization-grid" id="titleGrid">
                            <!-- Titles will be dynamically loaded here -->
                        </div>
                        
                        <h2 style="margin-top: 30px;">Select Your Title Color</h2>
                        <p class="photo-subtitle">Unlock new title colors through Battle Pass</p>
                        <div class="customization-grid" id="titleColorGrid">
                            <!-- Title colors will be dynamically loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Theme Customization Popup -->
                <div id="themePopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideThemePopup()">&times;</span>
                        <h2>Select Your Theme</h2>
                        <p class="photo-subtitle">Unlock new themes through Battle Pass</p>
                        <div class="customization-grid" id="themeGrid">
                            <!-- Themes will be dynamically loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Sound Pack Customization Popup -->
                <div id="soundPackPopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideSoundPackPopup()">&times;</span>
                        <h2 id="soundPackPopupTitle">Select Your Sound Pack</h2>
                        <p class="photo-subtitle" id="soundPackPopupSubtitle">Unlock new sound packs through Battle Pass</p>
                        <div class="customization-grid" id="soundPackGrid">
                            <!-- Sound packs will be dynamically loaded here -->
                        </div>
                        <!-- Custom sounds configuration (shown when Custom pack is selected) -->
                        <div id="customSoundsConfig" style="display: none;">
                            <div class="custom-sounds-grid" id="customSoundsGrid">
                                <!-- Custom sound options will be dynamically loaded here -->
                            </div>
                            <button class="save-custom-sounds-btn" onclick="saveCustomSounds()">Save Custom Sound Pack</button>
                        </div>
                    </div>
                </div>

                <!-- Badge Customization Popup -->
                <div id="badgePopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideBadgePopup()">&times;</span>
                        <h2>Select Your Profile Badge</h2>
                        <p class="photo-subtitle">Unlock badges through achievements</p>
                        <div class="customization-grid" id="badgeGrid">
                            <!-- Badges will be dynamically loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Emote Customization Popup -->
                <div id="emotePopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideEmotePopup()">&times;</span>
                        <h2>Select Your Emojis (Choose 4)</h2>
                        <p class="photo-subtitle">Unlock emojis through Battle Pass - Selected emojis will be available in-game</p>
                        <div class="selected-emojis-preview" id="selectedEmojisPreview">
                            <!-- Shows currently selected emojis -->
                        </div>
                        <div class="customization-grid" id="emoteGrid">
                            <!-- Emotes will be dynamically loaded here -->
                        </div>
                        <button class="save-emojis-btn" onclick="saveSelectedEmojis()">Save Emoji Selection</button>
                    </div>
                </div>

                <!-- Effects Customization Popup -->
                <div id="effectsPopup" class="customize-popup" style="display: none;">
                    <div class="customize-popup-content">
                        <span class="customize-popup-close" onclick="hideEffectsPopup()">&times;</span>
                        <h2>Select Your Effects</h2>
                        <p class="photo-subtitle">Unlock special effects through Battle Pass - Select multiple effects to use simultaneously</p>
                        <div class="selected-emojis-preview" id="selectedEffectsPreview">
                            <!-- Shows currently selected effects -->
                        </div>
                        <div class="customization-grid" id="effectsGrid">
                            <!-- Effects will be dynamically loaded here -->
                        </div>
                        <button class="save-emojis-btn" onclick="saveSelectedEffects()">Save Effect Selection</button>
                    </div>
                </div>

                <!-- Mystery Box Opening Modal -->
                <div id="mysteryBoxModal" class="mystery-box-modal" style="display: none;">
                    <div class="mystery-box-modal-content">
                        <div class="mystery-box-animation">
                            <div class="mystery-box-icon">📦</div>
                            <div class="mystery-box-sparkles">
                                <span class="sparkle">✨</span>
                                <span class="sparkle">✨</span>
                                <span class="sparkle">✨</span>
                                <span class="sparkle">✨</span>
                                <span class="sparkle">✨</span>
                                <span class="sparkle">✨</span>
                            </div>
                        </div>
                        <div class="mystery-box-result" id="mysteryBoxResult" style="display: none;">
                            <div class="reward-icon" id="rewardIcon">🎁</div>
                            <h2 class="reward-title" id="rewardTitle">You received:</h2>
                            <p class="reward-name" id="rewardName"></p>
                            <p class="reward-details" id="rewardDetails"></p>
                            <button class="reward-close-btn" onclick="closeMysteryBoxModal()">Awesome!</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Section -->
            <div class="profile-stats">
                <!-- Sound Effects Card -->
                <div class="stat-card">
                    <h2>Sound Effects</h2>
                    <p class="stat-label">Enable or disable game sound effects</p>
                    <div class="sound-control">
                        <label class="toggle-switch">
                            <input type="checkbox" id="soundToggle" checked>
                            <span class="slider-toggle"></span>
                        </label>
                        <span class="sound-status" id="soundStatus">ON</span>
                    </div>
                </div>

                <!-- Level Card -->
                <div class="stat-card">
                    <h2>Level</h2>
                    <div class="stat-value"><%= level || 1 %></div>
                    <a href="/battlepass" class="stat-label">Buy the pass to here, click me to visit!</a>
                </div>

                <!-- XP Card -->
                <div class="stat-card">
                    <h2>Experience Points</h2>
                    <div class="xp-numbers">
                        <div class="xp-item">
                            <span class="xp-item-label">Current XP</span>
                            <span class="xp-item-value"><%= xp || 0 %></span>
                        </div>
                        <div class="xp-item">
                            <span class="xp-item-label">XP Needed for level up</span>
                            <span class="xp-item-value"><%= xpForNextLevel || 100 %></span>
                        </div>
                        <div class="xp-item">
                            <span class="xp-item-label">XP Remaining to level up</span>
                            <span class="xp-item-value"><%= Math.max(0, (xpForNextLevel || 100) - (xp || 0)) %></span>
                        </div>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: <%= Math.min(100, Math.floor(((xp || 0) / (xpForNextLevel || 100)) * 100)) %>%;"></div>
                    </div>
                    <div class="progress-text">
                        <span><%= Math.min(100, Math.floor(((xp || 0) / (xpForNextLevel || 100)) * 100)) %>% to next level</span>
                    </div>
                </div>

                <!-- Onecells Card -->
                <div class="stat-card currency-card">
                    <h2>🪙 Onecells</h2>
                    <div class="stat-value currency-value"><%= onecells || 0 %></div>
                    <a href="/shop" class="stat-label currency-link">Visit Shop to buy more!</a>
                    <p class="currency-description">Use Onecells to purchase items in the shop</p>
                </div>

                <!-- Distractions Inventory Card -->
                <div class="stat-card inventory-card">
                    <h2>Inventory</h2>
                    <p class="stat-label">Your collection of game distractions, lootboxes, and other items</p>
                    <div class="inventory-grid">
                        <% 
                            let inventory = {};
                            let mysteryBoxes = {};
                            try {
                                inventory = JSON.parse(distractionsInventory || '{}');
                            } catch (e) {
                                inventory = {};
                            }
                            try {
                                mysteryBoxes = JSON.parse(mysteryBoxInventory || '{}');
                            } catch (e) {
                                mysteryBoxes = {};
                            }
                            const distractionEmojis = {
                                'Flashbang': '💥',
                                'Jumpscare': '😱',
                                'SubwaySurfers': '🚇',
                                'PeterGriffin': '👨',
                                'Shake': '📳',
                                'SixSeven': '🎵',
                                'Trollface': '😈'
                            };
                            const distractionNames = {
                                'Flashbang': 'Flashbang',
                                'Jumpscare': 'Jumpscare',
                                'SubwaySurfers': 'Subway Surfers',
                                'PeterGriffin': 'Peter Griffin',
                                'Shake': 'Shake',
                                'SixSeven': 'Six Seven',
                                'Trollface': 'Trollface'
                            };
                            const mysteryBoxEmojis = {
                                'standard': '📦'
                            };
                            const mysteryBoxNames = {
                                'standard': 'Mystery Box'
                            };
                            const hasDistractions = Object.keys(inventory).length > 0;
                            const hasMysteryBoxes = Object.keys(mysteryBoxes).length > 0;
                            const hasAnyItems = hasDistractions || hasMysteryBoxes;
                        %>
                        <% if (hasAnyItems) { %>
                            <% Object.entries(mysteryBoxes).forEach(([type, count]) => { %>
                                <% if (count > 0) { %>
                                    <div class="inventory-item">
                                        <span class="inventory-icon"><%= mysteryBoxEmojis[type] || '📦' %></span>
                                        <span class="inventory-name"><%= mysteryBoxNames[type] || type %></span>
                                        <span class="inventory-count">x<%= count %></span>
                                        <button class="inventory-action-btn" onclick="openMysteryBox('<%= type %>')">Open</button>
                                    </div>
                                <% } %>
                            <% }); %>
                            <% Object.entries(inventory).forEach(([type, count]) => { %>
                                <% if (count > 0) { %>
                                    <div class="inventory-item">
                                        <span class="inventory-icon"><%= distractionEmojis[type] || '🎮' %></span>
                                        <span class="inventory-name"><%= distractionNames[type] || type %></span>
                                        <span class="inventory-count">x<%= count %></span>
                                    </div>
                                <% } %>
                            <% }); %>
                        <% } else { %>
                            <div class="inventory-empty">
                                <p>No items yet!</p>
                                <a href="/shop" style="color: var(--primary-color); text-decoration: underline;">Visit the shop to purchase some</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/theme.js"></script>
    <script>
        // Load sound pack and custom sounds from server data to localStorage
        const selectedSoundPack = '<%= selectedSoundPack %>';
        if (selectedSoundPack) {
            localStorage.setItem('selectedSoundPack', selectedSoundPack);
        }
        
        const customSounds = '<%= customSounds %>';
        if (customSounds && customSounds !== '{}') {
            localStorage.setItem('customSounds', customSounds);
        } else {
            localStorage.removeItem('customSounds');
        }

        // Define popup functions first so they're available to onclick handlers
        function showCustomizePopup() {
            document.getElementById('customizePopup').style.display = 'flex';
        }

        function showPhotoChange() {
            document.getElementById('customizePhoto').style.display = 'flex';
            loadPhotoOptions();
        }

        function hidePhotoChange() {
            document.getElementById('customizePhoto').style.display = 'none';
        }
        
        function hideCustomizePopup() {
            document.getElementById('customizePopup').style.display = 'none';
        }

        function showTitlePopup() {
            document.getElementById('titlePopup').style.display = 'flex';
            loadTitleOptions();
            loadTitleColorOptions();
        }

        function hideTitlePopup() {
            document.getElementById('titlePopup').style.display = 'none';
        }

        function showThemePopup() {
            document.getElementById('themePopup').style.display = 'flex';
            loadThemeOptions();
        }

        function hideThemePopup() {
            document.getElementById('themePopup').style.display = 'none';
        }

        function showSoundPackPopup() {
            document.getElementById('soundPackPopup').style.display = 'flex';
            document.getElementById('soundPackGrid').style.display = 'grid';
            document.getElementById('customSoundsConfig').style.display = 'none';
            document.getElementById('soundPackPopupTitle').textContent = 'Select Your Sound Pack';
            document.getElementById('soundPackPopupSubtitle').textContent = 'Unlock new sound packs through Battle Pass';
            loadSoundPackOptions();
        }

        function hideSoundPackPopup() {
            document.getElementById('soundPackPopup').style.display = 'none';
        }

        // Mystery Box opening function
        function openMysteryBox(boxType) {
            if (!confirm('Open Mystery Box? You will receive a random reward!')) {
                return;
            }

            // Show the modal with animation
            showMysteryBoxModal();

            fetch('/api/open-mystery-box', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ boxType })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    setTimeout(() => {
                        showMysteryBoxReward(data.reward);
                    }, 2500); // Show reward after animation
                } else {
                    closeMysteryBoxModal();
                    alert(data.message || 'Failed to open mystery box');
                }
            })
            .catch(err => {
                console.error('Error opening mystery box:', err);
                closeMysteryBoxModal();
                alert('An error occurred. Please try again.');
            });
        }

        function showMysteryBoxModal() {
            const modal = document.getElementById('mysteryBoxModal');
            const animation = document.querySelector('.mystery-box-animation');
            const result = document.getElementById('mysteryBoxResult');
            
            modal.style.display = 'flex';
            animation.style.display = 'block';
            result.style.display = 'none';
            
            // Trigger shake animation
            setTimeout(() => {
