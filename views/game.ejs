      s.style.fontWeight = '';
      s.style.fontSize = '';
      // Send to server to validate and broadcast
      socket.emit('callOne', { gameId: gameId });
    });

    // Append the ONE button to the controls when available,
    // otherwise try the draw pile, and finally fallback to body
    function placeOneBtn() {
      // Always append to body when using fixed positioning so placement is predictable
      if (!document.body.contains(oneBtn)) document.body.appendChild(oneBtn);
    }
    placeOneBtn();

    // Create custom notification function for ONE calls (doesn't trigger alert sound)
    function showOneNotification(message) {
        const notification = document.createElement('div');
        notification.textContent = message;
        notification.style.cssText = `
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #f0c030 0%, #f39c12 100%);
            color: #1a1a1a;
            padding: 20px 40px;
            border-radius: 16px;
            font-size: 1.5rem;
            font-weight: 800;
            box-shadow: 0 8px 30px rgba(0,0,0,0.5);
            z-index: 10000;
            animation: popIn 0.3s ease-out;
        `;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transition = 'opacity 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 2000);
    }

