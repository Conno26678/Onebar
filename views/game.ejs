<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Game</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/cards-atlas.css">
    <style>
        /* Full viewport layout - no scrolling */
        html, body {
            height: 100%;
            overflow: hidden;
        }

        /* Game Container */
        .game-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 5px 15px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        /* Game Title */
        .game-title {
            text-align: center;
            font-size: 1.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-color), #ff6b6b, var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0 0 5px 0;
            letter-spacing: 2px;
            flex-shrink: 0;
        }

        /* Player List Panel */
        #playerList {
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px 12px;
            margin-bottom: 5px;
            box-shadow: 0 2px 10px var(--shadow), inset 0 1px 0 rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }

        #playerList span {
            background: var(--card-bg);
            padding: 5px 12px;
            border-radius: 15px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        #playerList span::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        #playerList span:hover::before {
            left: 100%;
        }

        #playerList span:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 6px 20px var(--shadow);
            border-color: var(--primary-color);
        }

        .current {
            font-weight: bold;
            border-color: var(--accent-color) !important;
            box-shadow: 0 0 20px rgba(40, 167, 69, 0.4) !important;
        }

        /* Status Panel */
        #status {
            background: linear-gradient(135deg, var(--primary-color), #ff6b6b);
            color: white;
            padding: 6px 15px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 5px;
            box-shadow: 0 2px 10px rgba(255, 0, 0, 0.3);
            flex-shrink: 0;
        }

        /* Table Area - Compact */
        #tableArea {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px;
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            border-radius: 12px;
            box-shadow: 0 2px 10px var(--shadow), inset 0 1px 0 rgba(255,255,255,0.1);
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

        #tableArea::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
            pointer-events: none;
        }

        /* Draw Pile & Discard Pile */
        #drawPile, #table {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 90px;
            padding: 8px;
            background: rgba(0,0,0,0.1);
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        #drawPile:hover, #table:hover {
            background: rgba(0,0,0,0.15);
            transform: translateY(-3px);
        }

        #table .wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        #drawCount {
            font-weight: 700;
            font-size: 0.75rem;
            margin-bottom: 5px;
            padding: 4px 10px;
            background: linear-gradient(135deg, var(--primary-color), #ff6b6b);
            color: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(255, 0, 0, 0.3);
        }

        #table .badge {
            font-weight: 700;
            margin-top: 8px;
            padding: 5px 12px;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.75rem;
        }

        /* Card Images on Table */
        #table img {
            width: 60px;
            border-radius: 6px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Draw Pile - normal card style */
        #drawPile {
            cursor: pointer;
        }

        #drawPile img {
            width: 85px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #drawPile:hover img {
            transform: scale(1.08) rotate(-3deg);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
        }

        #drawPile:hover img {
            transform: scale(1.08) rotate(-3deg);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
        }

        /* Hand Area - Large, takes remaining space */
        #hand {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: flex-start;
            align-content: flex-start;
            gap: 8px;
            padding: 15px;
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            border-radius: 16px;
            box-shadow: 0 4px 20px var(--shadow), inset 0 1px 0 rgba(255,255,255,0.1);
            border: 1px solid var(--border-color);
            min-height: 120px;
            overflow-y: auto;
            position: relative;
            flex: 1;
            margin-top: 8px;
        }

        #hand::before {
            content: 'Your Hand';
            position: absolute;
            top: -10px;
            left: 20px;
            background: var(--bg-color);
            padding: 2px 10px;
            font-weight: 600;
            font-size: 0.75rem;
            color: var(--secondary-color);
            border-radius: 6px;
        }

        #hand img {
            aspect-ratio: 241 / 361;
            cursor: pointer;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform-origin: bottom center;
        }

        #hand img:hover {
            transform: translateY(-15px) scale(1.2) rotate(-2deg);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);
            z-index: 100;
        }

        #hand img:active {
            transform: translateY(-10px) scale(1.1);
        }

        /* ONE Button Enhancement */
        #oneBtn {
            position: fixed !important;
            width: 100px !important;
            height: 100px !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            border-radius: 50% !important;
            border: 3px solid var(--primary-color) !important;
            background: linear-gradient(135deg, var(--card-bg), var(--hover-color)) !important;
            box-shadow: 0 6px 25px rgba(255, 0, 0, 0.4), inset 0 2px 0 rgba(255,255,255,0.2) !important;
            cursor: pointer !important;
            z-index: 9999 !important;
            right: 20px !important;
            bottom: 20px !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            animation: oneBtnPulse 2s ease-in-out infinite !important;
        }

        @keyframes oneBtnPulse {
            0%, 100% { box-shadow: 0 6px 25px rgba(255, 0, 0, 0.4), inset 0 2px 0 rgba(255,255,255,0.2); }
            50% { box-shadow: 0 6px 40px rgba(255, 0, 0, 0.6), inset 0 2px 0 rgba(255,255,255,0.2); }
        }

        #oneBtn:hover {
            transform: scale(1.1) !important;
            box-shadow: 0 10px 35px rgba(255, 0, 0, 0.6), inset 0 2px 0 rgba(255,255,255,0.2) !important;
        }

        #oneBtn img {
            width: 70px !important;
            height: 70px !important;
            object-fit: contain !important;
            border-radius: 50% !important;
            filter: drop-shadow(0 3px 6px rgba(0,0,0,0.3));
        }

        /* Color badges for wild cards */
        .color-red { background: linear-gradient(135deg, #ff4444, #cc0000) !important; color: white !important; }
        .color-blue { background: linear-gradient(135deg, #4444ff, #0000cc) !important; color: white !important; }
        .color-green { background: linear-gradient(135deg, #44ff44, #00cc00) !important; color: white !important; }
        .color-yellow { background: linear-gradient(135deg, #ffff44, #cccc00) !important; color: #333 !important; }

        /* Card Animation Styles */
        .card-flying {
            position: fixed !important;
            z-index: 10001 !important;
            pointer-events: none !important;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        .card-to-discard {
            animation: cardToDiscard 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        .card-to-hand {
            animation: cardToHand 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes cardPop {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .card-pop {
            animation: cardPop 0.3s ease-out;
        }

        @keyframes cardSlideIn {
            0% { 
                opacity: 0; 
                transform: translateY(30px) scale(0.8); 
            }
            100% { 
                opacity: 1; 
                transform: translateY(0) scale(1); 
            }
        }

        .card-slide-in {
            animation: cardSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        /* Color Picker Popup */
        .color-picker-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            animation: fadeIn 0.2s ease-out;
        }

        .color-picker-container {
            position: relative;
            width: 280px;
            height: 280px;
            animation: scaleIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes scaleIn {
            from { transform: scale(0.5); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .color-picker-title {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.2rem;
            font-weight: 700;
            color: white;
            text-align: center;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            pointer-events: none;
            z-index: 2;
        }

        .color-picker-segment {
            position: absolute;
            width: 50%;
            height: 50%;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .color-picker-segment:hover {
            transform: scale(1.15);
            z-index: 1;
            filter: brightness(1.3);
            box-shadow: 0 0 25px currentColor;
        }

        .color-picker-segment:active {
            transform: scale(1.05);
        }

        .color-picker-segment.red {
            top: 0;
            left: 0;
            background: linear-gradient(135deg, #ff4444, #cc0000);
            border-radius: 100% 0 0 0;
            box-shadow: -3px -3px 15px rgba(255, 68, 68, 0.5);
        }

        .color-picker-segment.blue {
            top: 0;
            right: 0;
            background: linear-gradient(135deg, #4488ff, #0044cc);
            border-radius: 0 100% 0 0;
            box-shadow: 3px -3px 15px rgba(68, 136, 255, 0.5);
        }

        .color-picker-segment.green {
            bottom: 0;
            left: 0;
            background: linear-gradient(135deg, #44cc44, #00aa00);
            border-radius: 0 0 0 100%;
            box-shadow: -3px 3px 15px rgba(68, 204, 68, 0.5);
        }

        .color-picker-segment.yellow {
            bottom: 0;
            right: 0;
            background: linear-gradient(135deg, #ffdd44, #ccaa00);
            border-radius: 0 0 100% 0;
            box-shadow: 3px 3px 15px rgba(255, 221, 68, 0.5);
        }

        .color-picker-segment span {
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            text-shadow: 0 1px 3px rgba(0,0,0,0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .color-picker-segment.yellow span {
            color: #333;
            text-shadow: 0 1px 3px rgba(255,255,255,0.4);
        }

        .color-picker-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 80px;
            background: var(--card-bg);
            border-radius: 50%;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 3;
        }

        .color-picker-center span {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-color);
            text-align: center;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            #hand img {
                width: 50px;
            }

            #hand img:hover {
                transform: translateY(-8px) scale(1.1);
            }

            #table img {
                width: 55px;
            }

            #tableArea {
                gap: 8px;
                padding: 5px;
            }

            #oneBtn {
                width: 70px !important;
                height: 70px !important;
                right: 10px !important;
                bottom: 10px !important;
            }

            #oneBtn img {
                width: 50px !important;
                height: 50px !important;
            }

            #playerList {
                padding: 4px 8px;
            }

            #playerList span {
                padding: 5px 10px;
                font-size: 0.8rem;
            }
        }

        @media (max-width: 480px) {
            .game-container {
                padding: 3px 8px;
            }

            #hand img {
                width: 45px;
            }

            #table img {
                width: 55px;
            }

            #drawPile img {
                width: 50px !important;
            }

            #hand {
                padding: 6px;
                min-height: 50px;
            }
        }

        /* Card play animation */
        @keyframes cardPlay {
            0% { transform: scale(1) translateY(0); opacity: 1; }
            50% { transform: scale(1.2) translateY(-50px); opacity: 0.8; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        .card-played {
            animation: cardPlay 0.5s ease-out;
        }

        /* Loading shimmer effect */
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .loading {
            background: linear-gradient(90deg, var(--card-bg) 25%, var(--hover-color) 50%, var(--card-bg) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
    </style>
</head>
<body>
  <!-- Logout button (upper-left) -->
  <a href="/logout" class="btn logout-button">🚪 Logout</a>
  
  <div class="game-container">
    <h1 class="game-title">ONEBAR</h1>
    <div id="playerList"><span class="loading" style="width: 200px; height: 20px; display: inline-block;"></span></div>
    <div id="status">Waiting for game to start...</div>
    <div id="tableArea"></div>
    <div id="table"></div>
    <div id="hand"></div>
  </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
</body>
<script>
    const socket = io();

    const gameId = <%- JSON.stringify(gameId || 'default') %>;
    let gameActive = true;

    const playerName = <%- JSON.stringify(user || 'Anonymous') %>;
    
    // Helper function to fix card IDs for CSS sprite matching
    // Server now generates correct IDs, but keep this for backwards compatibility
    function fixCardId(id) {
      if (!id) return id;
      // These replacements handle any old-format IDs that might still exist
      return id
        .split('Wild_Draw_Four').join('WildDrawFour')
        .split('Draw_Two').join('DrawTwo');
    }
    
    // Track if ONE has been called for current hand
    let oneCalledForCurrentHand = false;

    // Color Picker Function
    function showColorPicker(callback, title = 'Choose a Color') {
      // Create overlay
      const overlay = document.createElement('div');
      overlay.className = 'color-picker-overlay';
      
      // Create container
      const container = document.createElement('div');
      container.className = 'color-picker-container';
      
      // Create color segments
      const colors = ['red', 'blue', 'green', 'yellow'];
      colors.forEach(color => {
        const segment = document.createElement('div');
        segment.className = `color-picker-segment ${color}`;
        segment.innerHTML = `<span>${color}</span>`;
        segment.addEventListener('click', () => {
          overlay.remove();
          callback(color);
        });
        container.appendChild(segment);
      });
      
      // Create center circle with title
      const center = document.createElement('div');
      center.className = 'color-picker-center';
      center.innerHTML = `<span>${title}</span>`;
      container.appendChild(center);
      
      overlay.appendChild(container);
      document.body.appendChild(overlay);
      
      // Close on overlay click (outside the picker)
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.remove();
          callback('red'); // Default to red if closed without selection
        }
      });
    }

    // Tell server we've opened the game page so it can re-associate this socket
    socket.emit('joinGame', { playerName, gameId });

    socket.on('joined', ({ playerId, gameId }) => {
        console.log('joined', playerId, gameId);
        document.getElementById('status').innerText = `Joined game ${gameId} as ${playerName}`;
    });

    socket.on('playerList', (players) => {
        const el = document.getElementById('playerList');
        el.innerHTML = 'Players:' + players.map(p => `<span id="p_${p.id}">${p.name}</span>`).join(' | ');
    });
    let isInitialDeal = true;
    
    socket.on('deal', (hand) => {
        renderHand(hand, isInitialDeal); // Only animate on initial deal
        isInitialDeal = false; // After first deal, no more swoosh animations
        console.log('received deal', hand);
    });
    
    socket.on('gameStarted', ({currentPlayerId, players}) => {
      gameActive = true;
        updateCurrentPlayer(currentPlayerId);
    });

    socket.on('turnChanged', ({ currentPlayerId }) => {
        updateCurrentPlayer(currentPlayerId);
    });

    socket.on('cardPlacedOnTable', (card) => {
      addCardToTable(card, null, 'Top of Discard Pile');
    });

    socket.on('cardPlayed', ({ playerId, playerName, card }) => {
        addCardToTable(card, playerId, playerName);
        removeCardFromHand(card.id);
    });

    socket.on('invalidMove', ({ reason }) => {
        alert('Invalid move: ' + reason);
    });

      // only the player who receives this should be prompted (server sends to one socket)
        socket.on('requestStartColor', ({ gameId: gid, card }) => {
        showColorPicker((chosen) => {
          socket.emit('startColorChosen', { gameId: gameId || 'default', color: chosen });
        }, 'Starting card is Wild!');
    });

    socket.on('playerWon', ({ playerId, playerName }) => {
        alert(`${playerName} has won the game!`);
        disableGameUI();
    });

    socket.on('gameEnded', (data) => {
      console.log('gameEnded', data)
      disableGameUI();
      const winner = data?.winner;
      if (winner) {
        const status = document.getElementById('status');
        status.innerText = `Game over! Winner: ${winner.name || winner.id}`;
      }
    });

    function disableGameUI() {
      gameActive = false;
      const drawImg = document.getElementById('drawPileImg');
      if (drawImg) {
        drawImg.style.opacity = '0.5';
        drawImg.style.pointerEvents = 'none';
      }
      //remove hand click events
      document.querySelectorAll('#hand img').forEach(img => {
        img.style.opacity = '0.5';
        img.style.pointerEvents = 'none';
      });
        // optionally hide or disable Start Game button
      const startBtn = document.querySelector('button');
      if (startBtn) {
        startBtn.disabled = false; // keep available to start a new game if server supports it
      }
    }

    // Card Animation Functions
    function animateCardToDiscard(cardElement, cardImg) {
      return new Promise((resolve) => {
        const startRect = cardElement.getBoundingClientRect();
        const tableEl = document.getElementById('table');
        const endRect = tableEl.getBoundingClientRect();

        // Create flying card clone
        const flyingCard = document.createElement('img');
        flyingCard.src = cardImg;
        flyingCard.className = 'card-flying';
        flyingCard.style.width = cardElement.offsetWidth + 'px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Hide original card
        cardElement.style.opacity = '0';

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - cardElement.offsetWidth / 2) + 'px';
          flyingCard.style.top = (endRect.top + endRect.height / 2 - cardElement.offsetHeight / 2) + 'px';
          flyingCard.style.transform = 'scale(1.3) rotate(5deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function animateCardFromDeck() {
      return new Promise((resolve) => {
        const drawPile = document.getElementById('drawPileImg');
        const handEl = document.getElementById('hand');
        
        if (!drawPile || !handEl) {
          resolve();
          return;
        }

        const startRect = drawPile.getBoundingClientRect();
        const endRect = handEl.getBoundingClientRect();

        // Create flying card clone (card back)
        const flyingCard = document.createElement('img');
        flyingCard.src = '/img/cards/bing.png';
        flyingCard.className = 'card-flying';
        flyingCard.style.width = '85px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - 42) + 'px';
          flyingCard.style.top = (endRect.top + 10) + 'px';
          flyingCard.style.transform = 'scale(1.1) rotate(-3deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function renderHand(hand, animateAll = false) {
      const container = document.getElementById('hand');
      container.innerHTML = '';
      hand.forEach((card, index) => {
        const cardEl = document.createElement('div');
        cardEl.classList.add('card');
        // Fix the card id format for CSS sprite
        const fixedId = fixCardId(card.id);
        cardEl.dataset.cardId = fixedId;
        cardEl.title = `${card.name} (value ${card.value})`;
        
        // Only animate all cards on initial deal
        if (animateAll) {
          cardEl.classList.add('card-slide-in');
          cardEl.style.animationDelay = `${index * 0.05}s`;
        }
        
        cardEl.addEventListener('click', async () => {
          if (!gameActive) return;
          
          // Check if playing second-to-last card (will have 1 card after)
          const currentHandCount = document.querySelectorAll('#hand div[data-card-id]').length;
          const calledOne = oneCalledForCurrentHand;
          
          // Animate card to discard pile
          await animateCardToDiscard(cardEl, card.img);
          
          // Reset ONE called status after playing
          if (currentHandCount <= 2) {
            oneCalledForCurrentHand = false;
          }
          
          // play the card - send calledOne flag so server can check penalty
          if (card.color === 'wild') {
            showColorPicker((chosenColor) => {
              socket.emit('playCard', { gameId: gameId, cardId: card.id, chosenColor, calledOne });
            });
          } else {
            socket.emit('playCard', { gameId, cardId: card.id, calledOne });
          }
        });
        container.appendChild(cardEl);
      });
    }

    function addCardToTable(card, playerId, playerName) {
      const table = document.getElementById('table');
      //clear other cards only show top
      table.innerHTML = '';

      const wrapper = document.createElement('div');
      wrapper.style.display = 'inline-block';
      wrapper.style.textAlign = 'center';
      wrapper.style.margin = '8px';

      
      const who = document.createElement('div');
      who.innerText = playerName || (document.getElementById('p_' + playerId)?.textContent) || playerId;
      who.style.marginBottom = '4px';
      wrapper.appendChild(who);

      const cardEl = document.createElement('div');
      // Fix the card id format for CSS sprite
      const fixedId = fixCardId(card.id);
      cardEl.dataset.cardId = fixedId;
      cardEl.classList.add('card-pop', 'card'); // Add pop animation
      wrapper.appendChild(cardEl);

      const active = card.activeColor || card.chosenColor;
      if (active) {
        const badge = document.createElement('div');
        badge.innerText = `Color: ${active}`;
        badge.style.marginTop = '6px';
        badge.style.fontWeight = '600';
        wrapper.appendChild(badge);
      }

      table.appendChild(wrapper);
    }

    function removeCardFromHand(cardId) {
      // Fix the card id format for matching
      const fixedId = fixCardId(cardId);
      const cards = document.querySelectorAll('#hand div[data-card-id]');
      cards.forEach(card => {
        if (card.dataset.cardId === fixedId) card.remove();
      });
    }

     function updateCurrentPlayer(currentId, playerName) {
      const status = document.getElementById('status');
      const displayName = playerName || (document.getElementById('p_' + currentId)?.textContent) || currentId;
      status.innerText = `Current turn: ${displayName || currentId}`;
      // Highlight the player's name in playerList here
    }

    socket.on('playerList', (players) => {
      const el = document.getElementById('playerList');
      if (el) el.innerHTML = 'Players:' + players.map(p => `<span id="p_${p.id}">${p.name}${p.ready ? ' ✅' : ''}</span>`).join(' | ');
    });

    // ONE button: shows a "1" image and allows calling ONE
    const oneBtn = document.createElement('button');
    oneBtn.id = 'oneBtn';
    // Make the ONE button
    oneBtn.style.position = 'fixed';
    oneBtn.style.width = '160px';
    oneBtn.style.height = '160px';
    oneBtn.style.padding = '12px';
    oneBtn.style.display = 'flex';
    oneBtn.style.alignItems = 'center';
    oneBtn.style.justifyContent = 'center';
    oneBtn.style.borderRadius = '12px';
    // border and drop shadow so it appears cleaner
    oneBtn.style.border = 'none';
    oneBtn.style.background = 'transparent';
    oneBtn.style.boxShadow = 'none';
    oneBtn.style.cursor = 'pointer';
    oneBtn.style.zIndex = '9999';
    // place fixed in bottom-right corner 
    oneBtn.style.right = '12px';
    oneBtn.style.bottom = '12px';
    oneBtn.style.transform = 'none';
    oneBtn.style.transition = 'none';
    // If you don't have a "one" image, you can use text or a card image that represents "1".
    const oneImg = document.createElement('img');
    oneImg.src = '/img/ONElogo.png';
    oneImg.alt = 'ONE';
    oneImg.style.width = '140px';
    oneImg.style.height = '140px';
    oneImg.style.objectFit = 'contain';
    oneBtn.appendChild(oneImg);
    oneBtn.title = 'Press BEFORE playing your second-to-last card!';

    oneBtn.addEventListener('click', () => {
      const handCount = document.querySelectorAll('#hand div[data-card-id]').length;
      if (handCount !== 2) {
        // yell at them for clicking incorrectly
        alert("You don't have two cards — press ONE when you're about to play your second-to-last card!");
        return;
      }
      // Mark that ONE has been called for this hand (before playing the card)
      oneCalledForCurrentHand = true;
      alert("ONE called! Now play your card.");
    });

    // Append the ONE button to the controls container (right of piles) when available,
    // otherwise try the draw pile, and finally fallback to body.
    function placeOneBtn() {
      // Always append to body when using fixed positioning so placement is predictable
      if (!document.body.contains(oneBtn)) document.body.appendChild(oneBtn);
    }
    placeOneBtn();

    // No entrance animation: the ONE button stays fixed in bottom-right.

    // Listen for server confirmation / errors
    socket.on('playerCalledOne', ({ playerId, playerName }) => {
      alert(`${playerName || playerId} called ONE!`);
    });

    socket.on('invalidOneCall', ({ reason }) => {
      alert(`Invalid ONE call: ${reason || ''}`);
    });

    socket.on('playerPenalized', ({ playerId, playerName, count, reason }) => {
      const name = playerName || document.getElementById('p_' + playerId)?.textContent || playerId;
      if (reason === 'noOneCalled') {
        alert(`🚨 ${name} FORGOT TO CALL ONE! +${count} cards as penalty! 🚨`);
      } else {
        alert(`${name} failed to call ONE in time and drew ${count} card${count !== 1 ? 's' : ''}`);  
      }
    });


// Create draw pile UI 
const drawContainer = document.createElement('div');
drawContainer.id = 'drawPile';
drawContainer.style.display = 'inline-block';
drawContainer.style.textAlign = 'center';
drawContainer.style.margin = '8px';

// count badge (placed above the draw image)
const drawCount = document.createElement('div');
drawCount.id = 'drawCount';
drawCount.style.marginBottom = '6px';
drawCount.style.fontWeight = '600';
drawCount.innerText = ''; 
drawContainer.appendChild(drawCount);

// draw pile image - using card back
const drawImg = document.createElement('img');
drawImg.id = 'drawPileImg';
drawImg.src = '/img/cards/bing.png';
drawImg.alt = 'Draw Pile';
drawImg.title = 'Click to draw a card';
drawContainer.appendChild(drawImg);

// Place the draw pile and ensure the discard #table sit together inside #tableArea
const tableArea = document.getElementById('tableArea');
const tableEl = document.getElementById('table');

// Create a controls column (right side) to hold buttons like ONE
const controlContainer = document.createElement('div');
controlContainer.id = 'tableControls';
controlContainer.style.display = 'flex';
controlContainer.style.flexDirection = 'column';
controlContainer.style.alignItems = 'center';
controlContainer.style.minWidth = '80px';
controlContainer.style.margin = '8px';

// Append draw pile, table (discard), then controls to tableArea to form left->center->right
tableArea.appendChild(drawContainer);
if (tableEl.parentNode !== tableArea) {
  tableArea.appendChild(tableEl);
}
tableArea.appendChild(controlContainer);

// Force ordering: discard (table) left, draw pile center, controls right
tableEl.style.order = '1';
drawContainer.style.order = '2';
controlContainer.style.order = '3';

// Clicking the draw pile
drawImg.addEventListener('click', async () => {
  // Animate card from deck to hand
  await animateCardFromDeck();
  socket.emit('drawCard', { gameId: gameId });
});

// Update draw pile count when server tells us
socket.on('drawPileCount', ({ count }) => {
  const el = document.getElementById('drawCount');
  el.innerText = `Deck: ${count}`;
});

//  show a notification when any player draws
socket.on('playerDrew', ({ playerId, count }) => {
  const name = document.getElementById('p_' + playerId)?.textContent || playerId;
  const s = document.getElementById('status');
  s.innerText = `${name} drew ${count} card${count !== 1 ? 's' : ''}`;
});
</script>
</html>
