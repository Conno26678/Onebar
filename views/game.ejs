      document.body.appendChild(overlay);
    }

    // Register requestStartColor handler BEFORE joining game to avoid race condition
    socket.on('requestStartColor', ({ gameId: gid, card }) => {
        console.log('requestStartColor received, showing color picker...');
        showColorPicker((chosen) => {
          console.log('Color chosen:', chosen);
          socket.emit('startColorChosen', { gameId: gameId || 'default', color: chosen });
        }, 'Starting card is Wild!');
    });

    socket.on('drawnCardPlayable', ({ card, gameId: gid, isWild }) => {
      showDrawnCardChoice(card, isWild, (action, chosenColor) => {
        socket.emit('drawnCardChoice', {
          gameId: gameId,
          action,
          chosenColor
        });
      });
    });

    // Tell server we've opened the game page
    socket.emit('joinGame', { playerName, gameId });

    // Handle socket reconnection - automatically rejoin the game
    socket.on('connect', () => {
        console.log('Socket connected/reconnected');
        // Re-emit joinGame on reconnection to restore state
        socket.emit('joinGame', { playerName, gameId });
    });

    socket.on('disconnect', () => {
        console.log('Socket disconnected');
        document.getElementById('status').innerText = 'Connection lost. Reconnecting...';
    });

    socket.on('joined', ({ playerId, gameId }) => {
        console.log('joined', playerId, gameId);
        myPlayerId = playerId; // Store our player ID
        document.getElementById('status').innerText = `Joined game ${gameId} as ${playerName}`;
        // After first join, subsequent deals are reconnections - don't animate
        isInitialLoad = false;
    });

    socket.on('joinFailed', ({ reason }) => {
        console.error('Failed to join game:', reason);
        document.getElementById('status').innerText = `Failed to join: ${reason}`;
        alert('Failed to join game: ' + reason);
        // Redirect to lobby after a short delay
        setTimeout(() => {
            window.location.href = '/lobby';
        }, 2000);
    });

    socket.on('playerList', (players) => {
        const el = document.getElementById('playerList');
        if (el) el.innerHTML = 'Players: ' + players.map(p => {
          const badgeEmoji = getBadgeEmoji(p.selectedBadge);
          const badge = badgeEmoji ? `<span class="player-badge">${badgeEmoji}</span> ` : '';
          const titleColor = p.selectedTitleColor || 'inherit';
          
          // Store our own title color
          if (p.id === myPlayerId) {
            myTitleColor = p.selectedTitleColor || 'white';
          }
          
          return `<span id="p_${p.id}" style="color: ${titleColor}">${badge}${p.name} (${p.cardCount ?? '?'})</span>`;
        }).join(' | ');
    });

    let isInitialDeal = true;
    let currentHand = []; // Track current hand for restoring on invalid moves
    
    socket.on('deal', (hand) => {
        // Only animate on initial deal, not on reconnections
        const shouldAnimate = isInitialDeal && isInitialLoad;
        currentHand = hand; // Store the hand
        renderHand(hand, shouldAnimate);
        isInitialDeal = false;
        console.log('received deal', hand, 'animated:', shouldAnimate);
    });
    
    socket.on('gameStarted', ({currentPlayerId, players}) => {
      gameActive = true;
        currentTurnPlayerId = currentPlayerId;
        updateCurrentPlayer(currentPlayerId);
        // Play start game sound
        playSoundIfEnabled(getSoundPath('startgame'), 0.5);
    });

    socket.on('turnChanged', ({ currentPlayerId }) => {
        currentTurnPlayerId = currentPlayerId;
        updateCurrentPlayer(currentPlayerId);
        
        // Show turn timer when game is active
        const timerDisplay = document.getElementById('turnTimerDisplay');
        if (timerDisplay && gameActive) {
          timerDisplay.style.display = 'block';
        }
    });

    // Turn timer update
    socket.on('turnTimerUpdate', ({ timeRemaining }) => {
      const timerValue = document.getElementById('turnTimerValue');
      const timerDisplay = document.getElementById('turnTimerDisplay');
      
      if (timerValue) {
        timerValue.textContent = timeRemaining;
        
        // Change color based on time remaining
        if (timeRemaining <= 5) {
          timerValue.style.color = '#ff4444';
        } else if (timeRemaining <= 10) {
          timerValue.style.color = '#ffa500';
        } else {
          timerValue.style.color = '#4CAF50';
        }
      }
      
      if (timerDisplay && gameActive) {
        timerDisplay.style.display = 'block';
      }
    });

    // Turn auto-skipped notification
    socket.on('turnAutoSkipped', ({ playerId, playerName, timeoutCount }) => {
      console.log(`Turn auto-skipped for ${playerName} (${timeoutCount}/5 timeouts)`);
      const countMsg = timeoutCount ? ` (${timeoutCount}/5 timeouts)` : '';
      showGameNotification(`${playerName}'s turn was skipped (time ran out)${countMsg}`, 'warning');
      playSoundIfEnabled(getSoundPath('skip'), 0.5);
    });

    // Player kicked for inactivity
    socket.on('kickedForInactivity', ({ reason }) => {
      console.log('Kicked for inactivity:', reason);
      alert(reason);
      window.location.href = '/lobby';
    });

    // Another player was kicked
    socket.on('playerKicked', ({ playerId, playerName, reason }) => {
      console.log(`${playerName} was kicked for ${reason}`);
      showGameNotification(`${playerName} was kicked for inactivity`, 'error');
    });

    // 7-0 Rule: Show player selection when 7 is played
    socket.on('choosePlayerForSwap', ({ players }) => {
      console.log('Choose player for swap:', players);
      showPlayerSelection(players, (selectedPlayerId) => {
        console.log('Player selected for swap:', selectedPlayerId);
        socket.emit('chooseSwapTarget', { gameId, targetPlayerId: selectedPlayerId });
      });
    });

    // Notify when hands are swapped (7 rule)
    socket.on('handsSwapped', ({ player1, player2 }) => {
      console.log(`Hands swapped between ${player1.name} and ${player2.name}`);
      showGameNotification(`${player1.name} swapped hands with ${player2.name}!`, 'info');
      playSoundIfEnabled(getSoundPath('card'), 0.3);
    });

    // Notify when hands are rotated (0 rule)
    socket.on('handsRotated', ({ playerName, direction }) => {
      console.log(`${playerName} played a 0 - hands rotated ${direction}`);
      showGameNotification(`${playerName} played a 0! All hands rotated ${direction}!`, 'warning');
      playSoundIfEnabled(getSoundPath('card'), 0.3);
    });

    // Jump-in window
    socket.on('jumpInWindowOpened', ({ card, expiresAt }) => {
      console.log('Jump-in window opened:', card);
      jumpInWindowActive = true;
      
      // Check if player has a matching card
      const matchingCard = currentHand.find(c => 
        c.color === card.color && c.value === card.value
      );
      
      if (matchingCard && currentTurnPlayerId !== myPlayerId) {
        jumpInMatchingCard = matchingCard;
        const jumpInButton = document.getElementById('jumpInButton');
        const jumpInContainer = document.getElementById('jumpInContainer');
        const jumpInTimer = document.getElementById('jumpInTimer');
        
        jumpInButton.disabled = false;
        jumpInButton.classList.add('active');
        jumpInContainer.style.display = 'block';
        
        // Update timer display
        const updateTimer = () => {
          const remaining = Math.max(0, Math.ceil((expiresAt - Date.now()) / 1000));
          jumpInTimer.textContent = remaining + 's';
          
          if (remaining <= 0) {
            clearInterval(jumpInTimerInterval);
          }
        };
        
        updateTimer();
        jumpInTimerInterval = setInterval(updateTimer, 100);
        
        // Highlight the matching card
        const handContainer = document.getElementById('hand');
        const cardElements = handContainer.querySelectorAll('.card');
        cardElements.forEach(cardEl => {
          if (cardEl.dataset.cardId === fixCardId(matchingCard.id)) {
            cardEl.style.border = '3px solid gold';
            cardEl.style.boxShadow = '0 0 20px rgba(255, 215, 0, 0.8)';
          }
        });
      }
    });

    // Jump-in closed
    socket.on('jumpInWindowClosed', () => {
      console.log('Jump-in window closed');
      closeJumpInWindow();
    });

    // Someone jumped in
    socket.on('jumpedIn', ({ playerId, playerName }) => {
      console.log(`${playerName} jumped in!`);
      showGameNotification(`${playerName} jumped in!`, 'warning');
      playSoundIfEnabled(getSoundPath('card'), 0.5);
      closeJumpInWindow();
    });

    // Function to close jump-in window
    function closeJumpInWindow() {
      jumpInWindowActive = false;
      jumpInMatchingCard = null;
      
      const jumpInButton = document.getElementById('jumpInButton');
      const jumpInContainer = document.getElementById('jumpInContainer');
      
      if (jumpInButton) {
        jumpInButton.disabled = true;
        jumpInButton.classList.remove('active');
      }
      
      if (jumpInContainer) {
        jumpInContainer.style.display = 'none';
      }
      
      if (jumpInTimerInterval) {
        clearInterval(jumpInTimerInterval);
        jumpInTimerInterval = null;
      }
      
      // Remove card highlights
      const handContainer = document.getElementById('hand');
      if (handContainer) {
        const cardElements = handContainer.querySelectorAll('.card');
        cardElements.forEach(cardEl => {
          cardEl.style.border = '';
          cardEl.style.boxShadow = '';
        });
      }
    }

    // Jump-in button click handler
    document.getElementById('jumpInButton').addEventListener('click', () => {
      if (!jumpInWindowActive || !jumpInMatchingCard) {
        return;
      }
      
      console.log('Jumping in with card:', jumpInMatchingCard);
      socket.emit('jumpIn', { gameId, cardId: jumpInMatchingCard.id });
      
      // Immediately close the window (server will confirm)
      closeJumpInWindow();
    });

    socket.on('cardPlacedOnTable', (card) => {
      currentTableCard = card;
      addCardToTable(card, null, 'Top of Discard Pile', null);
      updateGameColors(card);
    });

    socket.on('cardPlayed', ({ playerId, playerName, card, selectedTitleColor }) => {
        currentTableCard = card; 
        addCardToTable(card, playerId, playerName, selectedTitleColor);
        removeCardFromHand(card.id);
        // Update local hand tracking
        currentHand = currentHand.filter(c => c.id !== card.id);
        
        // Update card count in player list when card is played
        const playerElement = document.getElementById('p_' + playerId);
        if (playerElement) {
          const currentText = playerElement.textContent;
          const match = currentText.match(/(.+)\s\((\d+)\)/);
          if (match) {
            const playerNameOnly = match[1];
            const currentCount = parseInt(match[2]);
            const newCount = Math.max(0, currentCount - 1);
            // Extract the badge part (everything before the player name)
            const fullHTML = playerElement.innerHTML;
            const badgeMatch = fullHTML.match(/^(<span[^>]*>.*?<\/span>\s*)?/);
            const badge = badgeMatch ? badgeMatch[0] : '';
            playerElement.innerHTML = badge + playerNameOnly + ' (' + newCount + ')';
          }
        }
        
        // Update game colors based on card played
        updateGameColors(card);
        
        // Close jump-in window when any card is played
        if (jumpInWindowActive) {
          closeJumpInWindow();
        }
        
        // Check if fire effect should trigger on +2 cards
        if (userSelectedEffects.includes('flames') && playerId === myPlayerId) {
          if (card.value === 'Draw Two' || card.id?.includes('DrawTwo')) {
            triggerBackgroundFireEffect();
          }
        }
        
        // Check if skip effect should trigger on skip cards
        if (userSelectedEffects.includes('skip') && playerId === myPlayerId) {
          if (card.value === 'Skip') {
            triggerSkipEffect();
          }
        }
        
        // Check if bow effect should trigger on +4 cards
        if (userSelectedEffects.includes('bow') && playerId === myPlayerId) {
          if (card.value === 'Wild Draw Four' || card.id?.includes('WildDrawFour')) {
            triggerBowArrowEffect();
          }
        }
        
        // Play sound effects based on card type
        if (card.value === 'Skip') {
          playSoundIfEnabled(getSoundPath('skip'), 0.4);
        } else if (card.value === 'Reverse') {
          playSoundIfEnabled(getSoundPath('reverse'), 0.4);
        } else if (card.value === 'Wild Draw Four' || card.id?.includes('WildDrawFour')) {
          playSoundIfEnabled(getSoundPath('plus4'), 0.4);
        } else if (card.value === 'Wild' || (card.color === 'wild' && card.value !== 'Wild Draw Four')) {
          playSoundIfEnabled(getSoundPath('wild'), 0.4);
        } else if (card.value === 'Draw Two' || card.id?.includes('DrawTwo')) {
          playSoundIfEnabled(getSoundPath('plus2'), 0.4);
        }
    });

    socket.on('invalidMove', ({ reason }) => {
        alert('Invalid move: ' + reason);
        // Re-render hand to restore
        renderHand(currentHand, false);
    });

    socket.on('gameEnded', (data) => {
      console.log('gameEnded', data)
      
      // Hide turn timer
      const timerDisplay = document.getElementById('turnTimerDisplay');
      if (timerDisplay) {
        timerDisplay.style.display = 'none';
      }
      
      disableGameUI();
    })

     function disableGameUI() {
      gameActive = false;
      
      // Disable draw pile
      const drawImg = document.getElementById('drawPileImg');
      if (drawImg) {
        drawImg.style.opacity = '0.5';
        drawImg.style.pointerEvents = 'none';
        drawImg.style.cursor = 'not-allowed';
      }
      
      // Disable all hand cards
      document.querySelectorAll('#hand .card, #hand div[data-card-id]').forEach(card => {
        card.style.opacity = '0.5';
        card.style.pointerEvents = 'none';
        card.style.cursor = 'not-allowed';
      });
      
      // Disable ONE button
      const oneBtn = document.getElementById('oneBtn');
      if (oneBtn) {
        oneBtn.style.opacity = '0.5';
        oneBtn.style.pointerEvents = 'none';
        oneBtn.style.cursor = 'not-allowed';
      }
      
      // Disable any other interactive elements
      document.querySelectorAll('button').forEach(btn => {
        if (!btn.closest('.win-modal')) {
          btn.disabled = true;
          btn.style.opacity = '0.5';
        }
      });
    }


    // Card Animation Functions
    function animateCardToDiscard(cardElement, cardImg) {
      return new Promise((resolve) => {
        const startRect = cardElement.getBoundingClientRect();
        const tableEl = document.getElementById('table');
        const endRect = tableEl.getBoundingClientRect();

        // Create flying card clone
        const flyingCard = document.createElement('img');
        flyingCard.src = cardImg;
        flyingCard.className = 'card-flying';
        flyingCard.style.width = cardElement.offsetWidth + 'px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Hide original card
        cardElement.style.opacity = '0';

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - cardElement.offsetWidth / 2) + 'px';
          flyingCard.style.top = (endRect.top + endRect.height / 2 - cardElement.offsetHeight / 2) + 'px';
          flyingCard.style.transform = 'scale(1.3) rotate(5deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function animateCardFromDeck() {
      return new Promise((resolve) => {
        const drawPile = document.getElementById('drawPileImg');
        const handEl = document.getElementById('hand');
        
        if (!drawPile || !handEl) {
          resolve();
          return;
        }

        const startRect = drawPile.getBoundingClientRect();
        const endRect = handEl.getBoundingClientRect();

        // Create flying card clone (card back)
        const flyingCard = document.createElement('img');
        flyingCard.src = '/img/cards/bing.png';
        flyingCard.className = 'card-flying';
        flyingCard.style.width = '85px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - 42) + 'px';
          flyingCard.style.top = (endRect.top + 10) + 'px';
          flyingCard.style.transform = 'scale(1.1) rotate(-3deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function renderHand(hand, animateAll = false) {
      const container = document.getElementById('hand');
      
      // Clean up any existing sparkle effects before clearing the hand
      const existingCards = container.querySelectorAll('.card');
      existingCards.forEach(card => removeSparkleEffect(card));
      
      container.innerHTML = '';
      
      hand.forEach((card, index) => {
        const cardEl = document.createElement('div');
        cardEl.classList.add('card');
        // Fix the card id format for CSS sprite
        const fixedId = fixCardId(card.id);
        cardEl.dataset.cardId = fixedId;
        cardEl.title = `${card.name} (value ${card.value})`;
        
        // Add subtle player color aura to hand cards (visible on hover)
        if (myTitleColor && myTitleColor !== 'white') {
          cardEl.style.setProperty('--player-aura-color', myTitleColor);
          cardEl.classList.add('has-player-aura');
        }
        
        // Only animate all cards on initial deal
        if (animateAll) {
          cardEl.classList.add('card-slide-in');
          cardEl.style.animationDelay = `${index * 0.05}s`;
        }
        
        cardEl.addEventListener('click', async () => {
          if (!gameActive) return;
          
          // Check if it's the player's turn BEFORE animation
          if (currentTurnPlayerId !== myPlayerId) {
            alert("It's not your turn! Wait for your turn to play.");
            return;
          }
          
          // Check if the card can be played BEFORE animation
          if (!canPlayCard(card)) {
            alert("You can't play that card! It doesn't match the color or value.");
            return;
          }
          
          // Remove sparkle effect before playing the card
          removeSparkleEffect(cardEl);
          
          // Animate card to discard pile
          await animateCardToDiscard(cardEl, card.img);
          
          // play the card
          if (card.color === 'wild') {
            showColorPicker((chosenColor) => {
              socket.emit('playCard', { gameId: gameId, cardId: card.id, chosenColor });
            });
          } else {
            socket.emit('playCard', { gameId, cardId: card.id });
          }
        });
        container.appendChild(cardEl);
      });
      
      // Reapply jump-in highlights if window is active
      if (jumpInWindowActive && jumpInMatchingCard) {
        const cardElements = container.querySelectorAll('.card');
        cardElements.forEach(cardEl => {
          if (cardEl.dataset.cardId === fixCardId(jumpInMatchingCard.id)) {
            cardEl.style.border = '3px solid gold';
            cardEl.style.boxShadow = '0 0 20px rgba(255, 215, 0, 0.8)';
          }
        });
      }
    }

    // Validate if a card can be played on the current table card
    function canPlayCard(card) {
      if (!currentTableCard) return true; 
      
      // Wild cards can always be played
      if (card.color === 'wild') return true;
      
      // Get the active color 
      const tableColor = currentTableCard.activeColor || currentTableCard.chosenColor || currentTableCard.color;
      const tableValue = currentTableCard.value;
      
      // Card matches if same color OR same value
      return card.color === tableColor || card.value === tableValue;
    }

    function addCardToTable(card, playerId, playerName, titleColor) {
      const table = document.getElementById('table');
      table.innerHTML = '';

      const wrapper = document.createElement('div');
      wrapper.style.display = 'inline-block';
      wrapper.style.textAlign = 'center';
      wrapper.style.margin = '8px';

      
      const who = document.createElement('div');
      who.innerText = playerName || (document.getElementById('p_' + playerId)?.textContent) || playerId;
      who.style.marginBottom = '4px';
      wrapper.appendChild(who);

      const cardEl = document.createElement('div');
      // Fix the card id format for CSS sprite
      const fixedId = fixCardId(card.id);
      cardEl.dataset.cardId = fixedId;
      cardEl.classList.add('card-pop', 'card');
      
      // Add player color aura if titleColor is provided
      if (titleColor && titleColor !== 'white') {
        cardEl.style.boxShadow = `0 0 15px 3px ${titleColor}, 0 0 25px 5px ${titleColor}80, 0 4px 15px rgba(0, 0, 0, 0.3)`;
        cardEl.style.transition = 'all 0.3s ease';
      }
      
      wrapper.appendChild(cardEl);

      const active = card.activeColor || card.chosenColor;
      if (active) {
        const badge = document.createElement('div');
        badge.innerText = `Color: ${active}`;
        badge.style.marginTop = '6px';
        badge.style.fontWeight = '600';
        wrapper.appendChild(badge);
      }

      table.appendChild(wrapper);
    }

    function removeCardFromHand(cardId) {
      // Fix the card id format for matching
      const fixedId = fixCardId(cardId);
      const cards = document.querySelectorAll('#hand div[data-card-id]');
      cards.forEach(card => {
        if (card.dataset.cardId === fixedId) card.remove();
      });
    }

     function updateCurrentPlayer(currentId, playerName) {
      const status = document.getElementById('status');
      const displayName = playerName || (document.getElementById('p_' + currentId)?.textContent) || currentId;
      // Make the player name black for better readability on the colored background
      status.innerHTML = `Current turn: <span style="color: #000; font-weight: 800;">${displayName || currentId}</span>`;
      
      // Gray out cards if it's not your turn
      const handElement = document.getElementById('hand');
      if (handElement) {
        if (currentId === myPlayerId) {
          handElement.classList.remove('not-turn');
        } else {
          handElement.classList.add('not-turn');
        }
      }
    }

    // Update game UI colors based on current playable color
    function updateGameColors(card) {
      if (!card) return;
      
      const gameTitle = document.getElementById('gameTitle');
      const statusBar = document.getElementById('status');
      
      if (!gameTitle || !statusBar) return;
      
      // Get the active color (wild cards have activeColor property)
      const activeColor = card.activeColor || card.color;
      
      let colorStart, colorEnd, shadowColor;
      
      switch(activeColor) {
        case 'red':
          colorStart = '#ff4444';
          colorEnd = '#cc0000';
          shadowColor = 'rgba(255, 68, 68, 0.5)';
          break;
        case 'blue':
          colorStart = '#4169E1';
          colorEnd = '#0047AB';
          shadowColor = 'rgba(65, 105, 225, 0.5)';
          break;
        case 'green':
          colorStart = '#28a745';
          colorEnd = '#198754';
          shadowColor = 'rgba(40, 167, 69, 0.5)';
          break;
        case 'yellow':
          colorStart = '#ffc107';
          colorEnd = '#ff9800';
          shadowColor = 'rgba(255, 193, 7, 0.5)';
          break;
        case 'wild':
          // Rainbow gradient for wild cards
          gameTitle.style.background = 'linear-gradient(135deg, #ff4444, #4169E1, #28a745, #ffc107)';
          gameTitle.style.webkitBackgroundClip = 'text';
          gameTitle.style.webkitTextFillColor = 'transparent';
          gameTitle.style.backgroundClip = 'text';
          
          statusBar.style.background = 'linear-gradient(135deg, #ff4444, #4169E1, #28a745, #ffc107)';
          statusBar.style.boxShadow = '0 3px 15px rgba(255, 193, 7, 0.4)';
          return;
        default:
          // Default gradient if color is unknown
          colorStart = '#f85149';
          colorEnd = '#ff6b6b';
          shadowColor = 'rgba(255, 0, 0, 0.4)';
      }
      
      // Update game title with gradient
      gameTitle.style.background = `linear-gradient(135deg, ${colorStart}, ${colorEnd})`;
      gameTitle.style.webkitBackgroundClip = 'text';
      gameTitle.style.webkitTextFillColor = 'transparent';
      gameTitle.style.backgroundClip = 'text';
      
      // Update status bar
      statusBar.style.background = `linear-gradient(135deg, ${colorStart}, ${colorEnd})`;
      statusBar.style.boxShadow = `0 3px 15px ${shadowColor}`;
    }

    // ONE button: shows a "1" image and allows calling ONE
    const oneBtn = document.createElement('button');
    oneBtn.id = 'oneBtn';
    // Make the ONE button
    oneBtn.style.position = 'fixed';
    oneBtn.style.width = '160px';
    oneBtn.style.height = '160px';
    oneBtn.style.padding = '12px';
    oneBtn.style.display = 'flex';
    oneBtn.style.alignItems = 'center';
    oneBtn.style.justifyContent = 'center';
    oneBtn.style.borderRadius = '12px';
    // border and drop shadow 
    oneBtn.style.border = 'none';
    oneBtn.style.background = 'transparent';
    oneBtn.style.boxShadow = 'none';
    oneBtn.style.cursor = 'pointer';
    oneBtn.style.zIndex = '9999';
    // place fixed in bottom-right corner 
    oneBtn.style.right = '12px';
    oneBtn.style.bottom = '12px';
    oneBtn.style.transform = 'none';
    oneBtn.style.transition = 'none';
    // If you don't have a "one" image, you can use text or a card image that represents "1".
    const oneImg = document.createElement('img');
    oneImg.src = '/img/ONElogo.png';
    oneImg.alt = 'ONE';
    oneImg.style.width = '140px';
    oneImg.style.height = '140px';
    oneImg.style.objectFit = 'contain';
    oneBtn.appendChild(oneImg);
    oneBtn.title = 'Press when you have ONE card left!';

    oneBtn.addEventListener('click', () => {
      const handCount = document.querySelectorAll('#hand div[data-card-id]').length;
      if (handCount !== 1) {
        alert('You can only call ONE when you have exactly 1 card left!');
        return;
      }
      
      // Trigger lightning effect if user has it equipped
      if (userSelectedEffects.includes('lightning')) {
        triggerLightningEffect(oneBtn);
      }
      
      // Clear the countdown timer when ONE is pressed
      if (oneCountdownInterval) {
        clearInterval(oneCountdownInterval);
        oneCountdownInterval = null;
      }
      // Clear the status message
      const s = document.getElementById('status');
