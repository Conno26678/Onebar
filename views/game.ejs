    function triggerBackgroundFireEffect() {
        // Disable on mobile for better performance
        if (isMobileDevice()) {
            console.log('Fire effect disabled on mobile');
            return;
        }
        const screenWidth = window.innerWidth;
        const screenHeight = window.innerHeight;
        
        // Create large background flames
        const largeFlameCount = 8 + Math.floor(Math.random() * 5);
        for (let i = 0; i < largeFlameCount; i++) {
            setTimeout(() => {
                const flame = document.createElement('div');
                flame.className = 'fire-particle';
                
                // Position along bottom of screen
                const startX = (screenWidth / largeFlameCount) * i + (Math.random() * (screenWidth / largeFlameCount));
                const startY = screenHeight - 20;
                
                flame.style.left = startX + 'px';
                flame.style.top = startY + 'px';
                
                // Make them larger
                flame.style.width = '40px';
                flame.style.height = '60px';
                
                // Large flames rise high
                const driftX = (Math.random() - 0.5) * 100;
                const riseY = -300 - Math.random() * 200;
                const rotation = (Math.random() - 0.5) * 180;
                
                flame.style.setProperty('--fire-x', driftX + 'px');
                flame.style.setProperty('--fire-y', riseY + 'px');
                flame.style.setProperty('--fire-rotation', rotation + 'deg');
                flame.style.animationDuration = (2 + Math.random() * 1) + 's';
                
                document.body.appendChild(flame);
                
                setTimeout(() => flame.remove(), 3500);
            }, i * 80);
        }
        
        // Create smaller flames across the bottom and sides of the screen
        const flameCount = 40 + Math.floor(Math.random() * 20);
        for (let i = 0; i < flameCount; i++) {
            setTimeout(() => {
                const flame = document.createElement('div');
                flame.className = 'fire-particle';
                
                // Random starting position along bottom and sides
                let startX, startY;
                const position = Math.random();
                if (position < 0.6) {
                    // Bottom of screen
                    startX = Math.random() * screenWidth;
                    startY = screenHeight - 20;
                } else if (position < 0.8) {
                    // Left side
                    startX = Math.random() * 100;
                    startY = Math.random() * screenHeight;
                } else {
                    // Right side
                    startX = screenWidth - (Math.random() * 100);
                    startY = Math.random() * screenHeight;
                }
                
                flame.style.left = startX + 'px';
                flame.style.top = startY + 'px';
                
                // Flames rise upward with drift
                const driftX = (Math.random() - 0.5) * 60;
                const riseY = -100 - Math.random() * 150;
                const rotation = (Math.random() - 0.5) * 180;
                
                flame.style.setProperty('--fire-x', driftX + 'px');
                flame.style.setProperty('--fire-y', riseY + 'px');
                flame.style.setProperty('--fire-rotation', rotation + 'deg');
                flame.style.animationDuration = (1.5 + Math.random() * 1) + 's';
                
                document.body.appendChild(flame);
                
                setTimeout(() => flame.remove(), 2800);
            }, i * 20);
        }
    }

