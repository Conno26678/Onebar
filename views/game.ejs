<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#f85149">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <title>Onebar - Game</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/cards-atlas.css">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/lobby.css">
    <link rel="stylesheet" href="/css/room.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <style>
        @keyframes popIn {
            0% {
                transform: translate(-50%, -50%) scale(0.5);
                opacity: 0;
            }
            100% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 1;
            }
        }
        
        /* Transfer button styling */
        .actions {
            margin-top: 20px;
        }
        
        .actions button.primary,
        button.primary {
            width: 100%;
            padding: 14px 28px;
            background: linear-gradient(135deg, #f0c030 0%, #f39c12 100%);
            color: #1a1a1a;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }
        
        .actions button.primary:hover,
        button.primary:hover {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(240, 192, 48, 0.4);
        }
        
        .actions button.primary:disabled,
        button.primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        /* Payment modal must be above winner modal (z-index 10000) */
        .payment-modal {
            z-index: 50000 !important;
            pointer-events: auto !important;
        }
        
        .payment-modal-content {
            z-index: 50001 !important;
            pointer-events: auto !important;
        }
        
        .payment-modal .card {
            pointer-events: auto !important;
        }
        
        .payment-modal button,
        .payment-modal input {
            pointer-events: auto !important;
            cursor: pointer;
        }
        
        /* Confetti animation */
        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }
        
        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            background-color: #f0f;
            top: -10px;
            opacity: 1;
            animation: confetti-fall linear forwards;
        }
        
        @keyframes confetti-fall {
            0% {
                transform: translateY(0) rotateZ(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotateZ(720deg);
                opacity: 0;
            }
        }
        
        /* Lightning bolt effect for ONE button */
        .lightning-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 99999;
            overflow: visible;
        }
        
        .lightning-bolt {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 99999;
        }
        
        .lightning-bolt svg {
            filter: drop-shadow(0 0 15px rgba(150, 200, 255, 1))
                    drop-shadow(0 0 30px rgba(100, 150, 255, 0.8))
                    drop-shadow(0 0 45px rgba(50, 100, 255, 0.6));
            animation: lightning-pulse 0.6s ease-out forwards;
        }
        
        @keyframes lightning-pulse {
            0% {
                opacity: 0;
                filter: brightness(3) drop-shadow(0 0 20px rgba(255, 255, 255, 1));
            }
            15% {
                opacity: 1;
                filter: brightness(3) drop-shadow(0 0 25px rgba(200, 220, 255, 1));
            }
            30% {
                opacity: 1;
                filter: brightness(2.5) drop-shadow(0 0 20px rgba(150, 200, 255, 0.9));
            }
            50% {
                opacity: 0.8;
                filter: brightness(2) drop-shadow(0 0 15px rgba(100, 150, 255, 0.7));
            }
            70% {
                opacity: 0.4;
                filter: brightness(1.5) drop-shadow(0 0 10px rgba(50, 100, 255, 0.5));
            }
            100% {
                opacity: 0;
                filter: brightness(1) drop-shadow(0 0 5px rgba(50, 100, 255, 0.2));
            }
        }
        
        .lightning-flash {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.5);
            pointer-events: none;
            z-index: 9997;
            animation: flash 0.5s ease-out forwards;
        }
        
        @keyframes flash {
            0% {
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            30% {
                opacity: 0.4;
            }
            50% {
                opacity: 0.2;
            }
            100% {
                opacity: 0;
            }
        }
        
        .lightning-glow {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 9996;
            animation: glow-expand 0.8s ease-out forwards;
        }
        
        @keyframes glow-expand {
            0% {
                width: 50px;
                height: 50px;
                opacity: 1;
                box-shadow: 0 0 20px 10px rgba(255, 255, 150, 0.8);
            }
            50% {
                opacity: 0.6;
                box-shadow: 0 0 40px 20px rgba(200, 200, 255, 0.6);
            }
            100% {
                width: 200px;
                height: 200px;
                opacity: 0;
                box-shadow: 0 0 60px 30px rgba(100, 100, 255, 0.2);
            }
        }
        
        /* Sparkle effect for last card */
        #hand .card.sparkle-glow {
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.8),
                        0 0 40px rgba(255, 215, 0, 0.6),
                        0 0 60px rgba(255, 215, 0, 0.4) !important;
            animation: sparkle-pulse 1.5s ease-in-out infinite !important;
            position: relative;
            z-index: 50 !important;
        }
        
        @keyframes sparkle-pulse {
            0%, 100% {
                box-shadow: 0 0 20px rgba(255, 215, 0, 0.8),
                            0 0 40px rgba(255, 215, 0, 0.6),
                            0 0 60px rgba(255, 215, 0, 0.4);
            }
            50% {
                box-shadow: 0 0 30px rgba(255, 215, 0, 1),
                            0 0 60px rgba(255, 215, 0, 0.8),
                            0 0 90px rgba(255, 215, 0, 0.6);
            }
        }
        
        .sparkle-particle {
            position: absolute;
            width: 10px;
            height: 10px;
            background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(255, 215, 0, 1) 50%, transparent 100%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9995;
            animation: sparkle-float linear forwards;
        }
        
        @keyframes sparkle-float {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translate(var(--sparkle-x), var(--sparkle-y)) scale(0.3);
            }
        }
        
        /* Fire effect for +2 cards */
        .fire-particle {
            position: absolute;
            width: 12px;
            height: 16px;
            background: radial-gradient(ellipse at bottom, rgba(255, 100, 0, 1) 0%, rgba(255, 200, 0, 0.9) 30%, rgba(255, 100, 0, 0.5) 60%, transparent 100%);
            border-radius: 50% 50% 40% 40% / 60% 60% 40% 40%;
            pointer-events: none;
            z-index: 9995;
            animation: fire-rise linear forwards;
        }
        
        @keyframes fire-rise {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1) rotate(0deg);
            }
            50% {
                opacity: 0.8;
                transform: translate(var(--fire-x), calc(var(--fire-y) * 0.5)) scale(1.2) rotate(var(--fire-rotation));
            }
            100% {
                opacity: 0;
                transform: translate(var(--fire-x), var(--fire-y)) scale(0.5) rotate(calc(var(--fire-rotation) * 2));
            }
        }
        
        /* Sparkle effect for last card */
        .sparkle-glow {
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.8),
                        0 0 40px rgba(255, 215, 0, 0.6),
                        0 0 60px rgba(255, 215, 0, 0.4) !important;
            animation: sparkle-pulse 1.5s ease-in-out infinite !important;
        }
        
        @keyframes sparkle-pulse {
            0%, 100% {
                box-shadow: 0 0 20px rgba(255, 215, 0, 0.8),
                            0 0 40px rgba(255, 215, 0, 0.6),
                            0 0 60px rgba(255, 215, 0, 0.4);
            }
            50% {
                box-shadow: 0 0 30px rgba(255, 215, 0, 1),
                            0 0 60px rgba(255, 215, 0, 0.8),
                            0 0 90px rgba(255, 215, 0, 0.6);
            }
        }
        
        .sparkle-particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(255, 215, 0, 1) 50%, transparent 100%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9995;
            animation: sparkle-float linear forwards;
        }
        
        @keyframes sparkle-float {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translate(var(--sparkle-x), var(--sparkle-y)) scale(0.3);
            }
        }
        
        /* Skip effect - red prohibition symbol */
        .skip-symbol {
            position: fixed;
            width: 200px;
            height: 200px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            pointer-events: none;
            z-index: 99999;
            animation: skip-popup 1.2s ease-out forwards;
        }
        
        .skip-symbol::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border: 20px solid #ff0000;
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.8),
                        0 0 60px rgba(255, 0, 0, 0.5),
                        inset 0 0 30px rgba(255, 0, 0, 0.3);
        }
        
        .skip-symbol::after {
            content: '';
            position: absolute;
            width: 180px;
            height: 20px;
            background: #ff0000;
            top: calc(50% - 10px);
            left: calc(50% - 90px);
            transform: rotate(0deg);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.8),
                        0 0 40px rgba(255, 0, 0, 0.5);
        }
        
        @keyframes skip-popup {
            0% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0) rotate(-180deg);
            }
            40% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.2) rotate(10deg);
            }
            60% {
                transform: translate(-50%, -50%) scale(0.95) rotate(-5deg);
            }
            80% {
                transform: translate(-50%, -50%) scale(1.05) rotate(2deg);
            }
            100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.8) rotate(0deg);
            }
        }
        
        /* Bow and arrow effect */
        .bow-arrow {
            position: fixed;
            width: 100px;
            height: 100px;
            pointer-events: none;
            z-index: 99999;
        }
        
        .bow-arrow-bow {
            position: absolute;
            width: 60px;
            height: 80px;
            left: 20px;
            top: 10px;
            border: 4px solid #8B4513;
            border-right: none;
            border-radius: 40px 0 0 40px;
            box-shadow: 0 0 10px rgba(139, 69, 19, 0.8);
            opacity: 0;
        }
        
        .bow-arrow-string {
            position: absolute;
            width: 2px;
            height: 80px;
            background: #DEB887;
            left: 20px;
            top: 10px;
            box-shadow: 0 0 5px rgba(222, 184, 135, 0.8);
            opacity: 0;
        }
        
        .bow-arrow-arrow {
            position: absolute;
            width: 80px;
            height: 4px;
            background: linear-gradient(to right, #8B4513 0%, #D2691E 60%, #FFD700 100%);
            top: 48px;
            left: 10px;
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.6);
            animation: arrow-shoot 0.8s ease-out forwards;
        }
        
        .bow-arrow-arrow::before {
            content: '';
            position: absolute;
            right: -10px;
            top: -6px;
            width: 0;
            height: 0;
            border-left: 15px solid #FFD700;
            border-top: 7px solid transparent;
            border-bottom: 7px solid transparent;
        }
        
        .bow-arrow-arrow::after {
            content: '';
            position: absolute;
            left: 0;
            top: -3px;
            width: 15px;
            height: 10px;
            background: #8B4513;
            border-radius: 0 5px 5px 0;
        }
        
        @keyframes arrow-shoot {
            0% {
                transform: translateY(0) rotate(90deg) scale(1);
                opacity: 1;
            }
            100% {
                transform: translateY(120vh) rotate(90deg) scale(1);
                opacity: 0;
            }
        }
        
        @keyframes bow-fade {
            0% {
                opacity: 1;
                transform: scale(1);
            }
            100% {
                opacity: 0;
                transform: scale(0.8);
            }
        }

        @keyframes slideInDown {
            from {
                transform: translate(-50%, -100px);
                opacity: 0;
            }
            to {
                transform: translate(-50%, 0);
                opacity: 1;
            }
        }

        @keyframes fadeOut {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
            }
        }

        /* Jump In Button Styles */
        .jump-in-button {
            background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
            color: #1a1a1a;
            border: 3px solid #fff;
            border-radius: 12px;
            padding: 15px 30px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(255, 215, 0, 0.5);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        .jump-in-button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(255, 215, 0, 0.7);
            background: linear-gradient(135deg, #ffed4e 0%, #ffd700 100%);
        }

        .jump-in-button:active:not(:disabled) {
            transform: translateY(0);
        }

        .jump-in-button:disabled {
            background: linear-gradient(135deg, #666 0%, #444 100%);
            cursor: not-allowed;
            opacity: 0.5;
            box-shadow: none;
        }

        .jump-in-icon {
            font-size: 24px;
            animation: pulse 1s infinite;
        }

        .jump-in-text {
            font-size: 20px;
            letter-spacing: 1px;
        }

        .jump-in-timer {
            position: absolute;
            top: 5px;
            right: 10px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background: rgba(0, 0, 0, 0.3);
            padding: 2px 8px;
            border-radius: 10px;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }

        @keyframes jumpInGlow {
            0%, 100% { box-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
            50% { box-shadow: 0 0 30px rgba(255, 215, 0, 1); }
        }

        .jump-in-button.active {
            animation: jumpInGlow 1s infinite;
        }
    </style>
</head>
<body>
  
  <!-- Emoji Reaction Button (upper-left) -->
  <button class="emoji-reaction-button" id="emojiReactionBtn" onclick="toggleEmojiMenu()">😊</button>
  
  <!-- Emoji Selection Menu -->
  <div class="emoji-menu" id="emojiMenu" style="display: none;">
    <div class="emoji-menu-item" data-emoji="0"></div>
    <div class="emoji-menu-item" data-emoji="1"></div>
    <div class="emoji-menu-item" data-emoji="2"></div>
    <div class="emoji-menu-item" data-emoji="3"></div>
  </div>
  
  <!-- Emoji Reactions Display Area -->
  <div class="emoji-reactions-area" id="emojiReactionsArea"></div>
  
  <!-- Distraction Button (upper-right) -->
  <button class="distraction-button" id="distractionBtn" onclick="toggleDistractionMenu()">🎯</button>
  
  <!-- Distraction Selection Menu -->
  <div class="distraction-menu" id="distractionMenu" style="display: none;">
    <!-- Distraction items will be dynamically populated -->
  </div>
  
  <!-- Confetti Container -->
  <div class="confetti-container" id="confettiContainer"></div>

  <div class="game-container">
    <h1 class="game-title" id="gameTitle">ONEBAR</h1>
    <div id="playerList"><span class="loading" style="width: 200px; height: 20px; display: inline-block;"></span></div>
    <div id="status">Waiting for game to start...</div>
    
    <!-- Turn Timer Display -->
    <div id="turnTimerDisplay" style="display: none; text-align: center; margin: 5px auto; font-size: 0.85rem; font-weight: 600; padding: 4px 12px; background: rgba(0,0,0,0.3); border-radius: 8px; max-width: fit-content;">
      Countdown before turn skip: <span id="turnTimerValue">15</span>s
    </div>
    
    <div id="tableArea"></div>
    <div id="table"></div>
    <div id="hand"></div>
    
    <!-- Jump In Button -->
    <div id="jumpInContainer" style="display: none; margin-top: 15px; text-align: center;">
      <button id="jumpInButton" class="jump-in-button" disabled>
        <span class="jump-in-icon"></span>
        <span class="jump-in-text">JUMP IN!</span>
        <span id="jumpInTimer" class="jump-in-timer"></span>
      </button>
    </div>
  </div>

  <!-- XP Notification Box -->
  <div id="xpNotification" class="xp-notification" style="display: none;">
    <div class="xp-notification-header">Level Up Progress</div>
    <div class="xp-notification-content">
      <div class="xp-notification-row">
        <span class="xp-notification-label">Player:</span>
        <span class="xp-notification-value" id="xpNotifPlayerName"></span>
      </div>
      <div class="xp-notification-row">
        <span class="xp-notification-label">Level:</span>
        <span class="xp-notification-value" id="xpNotifLevel"></span>
      </div>
      <div class="xp-notification-row xp-earned-row">
        <span class="xp-notification-label">XP Earned:</span>
        <span class="xp-notification-value xp-earned" id="xpNotifEarned"></span>
      </div>
    </div>
  </div>

  <!-- Lightning Container for ONE button effect -->
  <div id="lightningContainer" class="lightning-container"></div>

  <!-- Payment Modal -->
  <div id="paymentModal" class="payment-modal" style="display: none;">
    <div class="payment-modal-content">
      <span class="payment-modal-close" onclick="hidePaymentModal()">&times;</span>
      <%- include('partials/pay') %>
    </div>
  </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
</body>
<script>
    // Sound pack mapping
    const soundMappings = {
        default: {
            loading: '/sfx/loading.mp3',
            win: '/sfx/yippie.mp3',
            lose: '/sfx/spongebobfail.mp3',
            plus2: '/sfx/slap.mp3',
            reverse: '/sfx/reverse.mp3',
            skip: '/sfx/pluh.mp3',
            startgame: '/sfx/afewmoments.mp3',
            wild: '/sfx/omaewa.mp3',
            plus4: '/sfx/slap.mp3',
            cardPlace: '/sfx/pluh.mp3'
        },
        hayden: {
            loading: '/sfx/loading.mp3',
            win: '/sfx/haydenwinner.mp3',
            lose: '/sfx/haydenlose.mp3',
            plus2: '/sfx/hayden+2.mp3',
            reverse: '/sfx/haydenreverse.mp3',
            skip: '/sfx/haydenskip.mp3',
            startgame: '/sfx/haydenstartgame.mp3',
            wild: '/sfx/haydenwild.mp3',
            plus4: '/sfx/hayden+4.mp3',
            cardPlace: '/sfx/pluh.mp3'
        },
        custom: {
            loading: '/sfx/loading.mp3',
            win: '/sfx/yippie.mp3',
            lose: '/sfx/spongebobfail.mp3',
            plus2: '/sfx/slap.mp3',
            reverse: '/sfx/reverse.mp3',
            skip: '/sfx/pluh.mp3',
            startgame: '/sfx/afewmoments.mp3',
            wild: '/sfx/omaewa.mp3',
            plus4: '/sfx/slap.mp3',
            cardPlace: '/sfx/pluh.mp3'
        }
    };

    // Sync sound preferences from server (authoritative source) into localStorage
    (function syncSoundPrefs() {
        const serverSoundPack = '<%- selectedSoundPack || "default" %>';
        const serverCustomSounds = '<%- customSounds || "{}" %>';
        if (serverSoundPack) {
            localStorage.setItem('selectedSoundPack', serverSoundPack);
        }
        if (serverCustomSounds && serverCustomSounds !== '{}') {
            localStorage.setItem('customSounds', serverCustomSounds);
        } else {
            // Clear stale custom sounds so they don't override the chosen pack
            localStorage.removeItem('customSounds');
        }
    })();

    // Function to get current sound pack
    function getCurrentSoundPack() {
        return localStorage.getItem('selectedSoundPack') || 'default';
    }

    // Function to get sound path based on custom sounds and selected pack
    function getSoundPath(soundType) {
        const pack = getCurrentSoundPack();
        
        // Only use custom sounds when the 'custom' pack is active
        if (pack === 'custom') {
            const customSoundsRaw = localStorage.getItem('customSounds');
            if (customSoundsRaw && customSoundsRaw !== '{}') {
                try {
                    const customSoundsObj = JSON.parse(customSoundsRaw);
                    if (customSoundsObj[soundType]) {
                        console.log(`Playing custom sound for ${soundType}:`, customSoundsObj[soundType]);
                        return customSoundsObj[soundType];
                    }
                } catch (e) {
                    console.log('Error parsing custom sounds:', e);
                }
            }
            // Fall through to default if this custom slot wasn't configured
        }
        
        // Use the selected pack (or default as fallback)
        const soundPath = soundMappings[pack]?.[soundType] || soundMappings.default[soundType];
        console.log(`Playing ${pack} sound for ${soundType}:`, soundPath);
        return soundPath;
    }

    // Sound control helper function
    function playSoundIfEnabled(soundPath, volume = 0.5) {
        const soundEnabled = localStorage.getItem('soundEffectsEnabled');
        if (soundEnabled === 'false') {
            console.log('Sound disabled, skipping:', soundPath);
            return null;
        }
        const audio = new Audio(soundPath);
        audio.volume = volume;
        audio.play().catch(err => console.log('Sound play failed:', err));
        return audio;
    }

    // Override alert to play loading sound
    const originalAlert = window.alert;
    window.alert = function(message) {
        playSoundIfEnabled(getSoundPath('loading'), 0.5);
        originalAlert.call(window, message);
    };
    
    // Mobile detection utility
    function isMobileDevice() {
        return window.innerWidth <= 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }
    
    // Confetti effect function
    function triggerConfetti(duration = 6000) {
        // Disable on mobile for better performance
        if (isMobileDevice()) {
            console.log('Confetti disabled on mobile');
            return;
        }
        const container = document.getElementById('confettiContainer');
        if (!container) return;
        
