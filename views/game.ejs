<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Game</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/cards-atlas.css">
    <link rel="stylesheet" href="/css/game.css">
    <link rel="stylesheet" href="/css/lobby.css">
    <link rel="stylesheet" href="/css/room.css">
    <style>
        @keyframes popIn {
            0% {
                transform: translate(-50%, -50%) scale(0.5);
                opacity: 0;
            }
            100% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 1;
            }
        }
        
        /* Transfer button styling */
        .actions {
            margin-top: 20px;
        }
        
        .actions button.primary,
        button.primary {
            width: 100%;
            padding: 14px 28px;
            background: linear-gradient(135deg, #f0c030 0%, #f39c12 100%);
            color: #1a1a1a;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }
        
        .actions button.primary:hover,
        button.primary:hover {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(240, 192, 48, 0.4);
        }
        
        .actions button.primary:disabled,
        button.primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        /* Payment modal must be above winner modal (z-index 10000) */
        .payment-modal {
            z-index: 50000 !important;
            pointer-events: auto !important;
        }
        
        .payment-modal-content {
            z-index: 50001 !important;
            pointer-events: auto !important;
        }
        
        .payment-modal .card {
            pointer-events: auto !important;
        }
        
        .payment-modal button,
        .payment-modal input {
            pointer-events: auto !important;
            cursor: pointer;
        }
    </style>
</head>
<body>
  <!-- Logout button (upper-left) -->
  <a href="/logout" class="btn logout-button">Logout</a>

  <div class="game-container">
    <h1 class="game-title">ONEBAR</h1>
    <div id="playerList"><span class="loading" style="width: 200px; height: 20px; display: inline-block;"></span></div>
    <div id="status">Waiting for game to start...</div>
    <div id="tableArea"></div>
    <div id="table"></div>
    <div id="hand"></div>
  </div>

  <!-- XP Notification Box -->
  <div id="xpNotification" class="xp-notification" style="display: none;">
    <div class="xp-notification-header">Level Up Progress</div>
    <div class="xp-notification-content">
      <div class="xp-notification-row">
        <span class="xp-notification-label">Player:</span>
        <span class="xp-notification-value" id="xpNotifPlayerName"></span>
      </div>
      <div class="xp-notification-row">
        <span class="xp-notification-label">Level:</span>
        <span class="xp-notification-value" id="xpNotifLevel"></span>
      </div>
      <div class="xp-notification-row xp-earned-row">
        <span class="xp-notification-label">XP Earned:</span>
        <span class="xp-notification-value xp-earned" id="xpNotifEarned"></span>
      </div>
    </div>
  </div>

  <!-- Payment Modal -->
  <div id="paymentModal" class="payment-modal" style="display: none;">
    <div class="payment-modal-content">
      <span class="payment-modal-close" onclick="hidePaymentModal()">&times;</span>
      <%- include('partials/pay') %>
    </div>
  </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
</body>
<script>
    // Sound pack mapping
    const soundMappings = {
        default: {
            loading: '/sfx/loading.mp3',
            win: '/sfx/yippie.mp3',
            lose: '/sfx/spongebobfail.mp3',
            plus2: '/sfx/slap.mp3',
            reverse: '/sfx/reverse.mp3',
            skip: '/sfx/pluh.mp3',
            startgame: '/sfx/afewmoments.mp3'
        },
        hayden: {
            loading: '/sfx/loading.mp3',
            win: '/sfx/haydenwinner.mp3',
            lose: '/sfx/haydenlose.mp3',
            plus2: '/sfx/hayden+2.mp3',
            reverse: '/sfx/haydenreverse.mp3',
            skip: '/sfx/haydenskip.mp3',
            startgame: '/sfx/haydenstartgame.mp3',
            wild: '/sfx/haydenwild.mp3',
            plus4: '/sfx/hayden+4.mp3'
        }
    };

    // Function to get current sound pack
    function getCurrentSoundPack() {
        return localStorage.getItem('selectedSoundPack') || 'default';
    }

    // Function to get sound path based on selected pack
    function getSoundPath(soundType) {
        const pack = getCurrentSoundPack();
        return soundMappings[pack]?.[soundType] || soundMappings.default[soundType];
    }

    // Sound control helper function
    function playSoundIfEnabled(soundPath, volume = 0.5) {
        const soundEnabled = localStorage.getItem('soundEffectsEnabled');
        if (soundEnabled === 'false') {
            console.log('Sound disabled, skipping:', soundPath);
            return null;
        }
        const audio = new Audio(soundPath);
        audio.volume = volume;
        audio.play().catch(err => console.log('Sound play failed:', err));
        return audio;
    }

    // Override alert to play loading sound
    const originalAlert = window.alert;
    window.alert = function(message) {
        playSoundIfEnabled(getSoundPath('loading'), 0.5);
        originalAlert.call(window, message);
    };

    const socket = io();

    const gameId = <%- JSON.stringify(gameId || 'default') %>;
    let gameActive = true;

    const playerName = <%- JSON.stringify(user || 'Anonymous') %>;
    
    // Track if this is the initial page load vs a reconnection
    let isInitialLoad = true;

    //store lobby ID
    let currentRommId = gameId;
    
    // Track payment status
    let hasPaid = false;
    
    // Listen for payment status updates
    socket.on('paymentStatus', ({ hasPaid: paid }) => {
        hasPaid = paid;
        console.log('Payment status updated in game:', hasPaid);
    });
    
    // Badge to emoji mapping
    function getBadgeEmoji(badge) {
      if (!badge || badge === 'none') return '';
      // If badge is already an emoji or custom value, return it as-is
      // Otherwise map common text names to emojis
      const badgeMap = {
        'Trophy': '🏆',
        'Gold': '🥇',
        'Silver': '🥈',
        'Bronze': '🥉',
        'Premium Diamond': '💎'
      };
      return badgeMap[badge] || badge;
    }
    
    // Track current turn player
    let currentTurnPlayerId = null;
    let myPlayerId = null;
    let currentTableCard = null; // Track the card on top of discard pile

    function showWinMedal(winnerName, isCurrentUserWinner, winnerTitle = 'Newbie', winnerTitleColor = 'white') {
      disableGameUI();
      
      // Play appropriate sound based on win/lose
      if (isCurrentUserWinner) {
        playSoundIfEnabled(getSoundPath('win'), 0.5);
      } else {
        playSoundIfEnabled(getSoundPath('lose'), 0.5);
      }

      const overlay = document.createElement('div');
      overlay.className = 'win-modal-overlay';

      const modal = document.createElement('div');
      modal.className = 'win-modal';

      const trophy = document.createElement('div');
      trophy.className = 'win-modal-trophy';
      trophy.textContent = isCurrentUserWinner ? '🏆' : '';
      if (trophy.textContent) modal.appendChild(trophy);

      const title = document.createElement('div');
      title.className = 'win-modal-title';
      title.textContent = isCurrentUserWinner ? 'Congratulations! You Won!' : `get gud`;
      modal.appendChild(title);

      const winner = document.createElement('div');
      winner.className = 'win-modal-winner';
      
      // Create title span
      const titleSpan = document.createElement('span');
      titleSpan.textContent = `[${winnerTitle}] `;
      titleSpan.style.color = winnerTitleColor;
      
      // Create name span
      const nameSpan = document.createElement('span');
      nameSpan.textContent = winnerName;
      nameSpan.style.color = winnerTitleColor;
      
      winner.appendChild(titleSpan);
      winner.appendChild(nameSpan);
      modal.appendChild(winner);

      const subtitle = document.createElement('div');
      subtitle.className = 'win-modal-subtitle';
      subtitle.textContent = isCurrentUserWinner ? 'Congrats on your win' : `${winnerName} has won the game!`;
      modal.appendChild(subtitle);

      const buttons = document.createElement('div');
      buttons.className = 'win-modal-buttons';

      const playAgainBtn = document.createElement('button');
      playAgainBtn.className = 'win-modal-btn play-again';
      playAgainBtn.textContent = 'Play Again';
      playAgainBtn.addEventListener('click', () => {
        window.location.href = '/room/' + encodeURIComponent(currentRommId);
      });
      buttons.appendChild(playAgainBtn);

      const goHomeBtn = document.createElement('button');
      goHomeBtn.className = 'win-modal-btn go-home';
      goHomeBtn.textContent = 'Go to Home';
      goHomeBtn.addEventListener('click', () => {
        window.location.href = '/';
      });
      buttons.appendChild(goHomeBtn);

      modal.appendChild(buttons);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);

      //Prevent clicking through overlay
      overlay.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    }
    
    // Helper function to fix card IDs for CSS sprite matching
    function fixCardId(id) {
      if (!id) return id;
      // These replacements handle any old-format IDs that might still exist
      return id
        .split('Wild_Draw_Four').join('WildDrawFour')
        .split('Draw_Two').join('DrawTwo');
    }

    // Color Picker Function
    function showColorPicker(callback, title = 'Choose a Color') {
      // Create overlay
      const overlay = document.createElement('div');
      overlay.className = 'color-picker-overlay';
      
      // Create container
      const container = document.createElement('div');
      container.className = 'color-picker-container';
      
      // Create color segments
      const colors = ['red', 'blue', 'green', 'yellow'];
      colors.forEach(color => {
        const segment = document.createElement('div');
        segment.className = `color-picker-segment ${color}`;
        segment.innerHTML = `<span>${color}</span>`;
        segment.addEventListener('click', () => {
          overlay.remove();
          callback(color);
        });
        container.appendChild(segment);
      });
      
      // Create center circle with title
      const center = document.createElement('div');
      center.className = 'color-picker-center';
      center.innerHTML = `<span>${title}</span>`;
      container.appendChild(center);
      
      overlay.appendChild(container);
      document.body.appendChild(overlay);
      
      // Close on overlay click (outside the picker)
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.remove();
          callback('red'); // Default to red if closed without selection
        }
      });
    }
    // Listen for XP gained from server (has correct level calculation)
    socket.on('xpGained', ({ xpAdded, currentXP, level, levelsGained, xpForNextLevel }) => {
      console.log('⭐ XP Gained from server:', { xpAdded, currentXP, level, levelsGained, xpForNextLevel });
      
      // Show XP notification box in upper right corner
      const xpNotification = document.getElementById('xpNotification');
      const xpNotifPlayerName = document.getElementById('xpNotifPlayerName');
      const xpNotifLevel = document.getElementById('xpNotifLevel');
      const xpNotifEarned = document.getElementById('xpNotifEarned');
      
      if (xpNotification && xpNotifPlayerName && xpNotifLevel && xpNotifEarned) {
        console.log('📝 Setting XP notification content...');
        xpNotifPlayerName.textContent = playerName;
        xpNotifLevel.textContent = level; // Use level from server
        xpNotifEarned.textContent = `+${xpAdded} XP`;
        
        console.log('🎨 Displaying XP notification...');
        xpNotification.style.display = 'block';
        xpNotification.style.opacity = '1';
        xpNotification.style.visibility = 'visible';
        
        // Animate in
        setTimeout(() => {
          xpNotification.style.animation = 'slideInRight 0.5s ease-out';
          console.log('✅ XP Notification displayed and animated');
        }, 100);
        
        // Show level up message if they gained levels
        if (levelsGained > 0) {
          console.log(`🎉 Level up! Gained ${levelsGained} level(s). Now level ${level}`);
        }
      } else {
        console.error('❌ XP Notification element not found!');
      }
    });

    socket.on('showWinnerScreen', ({ winnerName, winnerId, digipogs, playerCount, payoutError, payoutErrorMessage }) => {
  console.log('🏆 Winner screen data:', { winnerName, winnerId, digipogs, playerCount, payoutError });
  
  const isCurrentUserWinner = (winnerName === playerName);
  
  // Note: XP notification is now handled by the xpGained event from the server
  
  // Create winner modal overlay
  const overlay = document.createElement('div');
  overlay.id = 'winnerModal';
  overlay.style.display = 'block';
  overlay.style.position = 'fixed';
  overlay.style.zIndex = '10000';
  overlay.style.left = '0';
  overlay.style.top = '0';
  overlay.style.width = '100%';
  overlay.style.height = '100%';
  overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.8)';
  
  const content = document.createElement('div');
  content.className = 'winner-content';
  content.style.position = 'relative';
  content.style.background = '#0d1117';
  content.style.margin = '10% auto';
  content.style.padding = '40px';
  content.style.borderRadius = '20px';
  content.style.width = '90%';
  content.style.maxWidth = '500px';
  content.style.textAlign = 'center';
  content.style.boxShadow = '0 20px 60px rgba(0, 0, 0, 0.5)';
  content.style.border = '1px solid #30363d';
  
  // isCurrentUserWinner already declared above
  
  const title = document.createElement('h2');
  title.textContent = isCurrentUserWinner ? '🏆 Winner!' : 'get gud';
  title.style.color = isCurrentUserWinner ? '#ffd700' : '#ff6b6b';
  title.style.fontSize = '2.5em';
  title.style.marginBottom = '20px';
  title.style.textShadow = '2px 2px 4px rgba(0, 0, 0, 0.5)';
  content.appendChild(title);
  
  const name = document.createElement('div');
  name.className = 'winner-name';
  name.textContent = isCurrentUserWinner ? 'You are the winner!' : `${winnerName} won`;
  name.style.fontSize = '2em';
  name.style.color = '#fff';
  name.style.margin = '20px 0';
  name.style.fontWeight = 'bold';
  content.appendChild(name);
  
  const amount = document.createElement('div');
  amount.className = 'winner-amount';
  if (payoutError && isCurrentUserWinner) {
    // Only show error to the winner
    amount.textContent = 'Payout Error';
    amount.style.color = '#ff6b6b';
    amount.style.fontSize = '1.8em';
    amount.style.margin = '20px 0';
    amount.style.fontWeight = 'bold';
    content.appendChild(amount);
    
    const errorMessage = document.createElement('div');
    errorMessage.className = 'payout-error-message';
    errorMessage.textContent = payoutErrorMessage || 'Failed to process payout - Contact Support';
    errorMessage.style.color = '#ff8585';
    errorMessage.style.fontSize = '1.1em';
    errorMessage.style.margin = '15px 0';
    errorMessage.style.padding = '10px';
    errorMessage.style.backgroundColor = 'rgba(255, 107, 107, 0.1)';
    errorMessage.style.borderRadius = '8px';
    errorMessage.style.border = '1px solid rgba(255, 107, 107, 0.3)';
    content.appendChild(errorMessage);
  } else {
    // Normal winner/loser display
    if (isCurrentUserWinner) {
      amount.textContent = `You won ${digipogs} Digipogs!`;
    } else {
      amount.textContent = `${winnerName} won ${digipogs} Digipogs!`;
      
      const encouragement = document.createElement('div');
      encouragement.style.color = '#a0aec0';
      encouragement.style.fontSize = '1.1em';
      encouragement.style.marginTop = '10px';
      encouragement.textContent = 'Try to win next time to earn some!';
      content.appendChild(encouragement);
    }
    amount.style.color = '#ffd700';
    amount.style.fontSize = '1.8em';
    amount.style.margin = '20px 0';
    amount.style.fontWeight = 'bold';
    content.appendChild(amount);
  }
  
  const playerInfo = document.createElement('div');
  playerInfo.textContent = `${playerCount} players competed`;
  playerInfo.style.color = '#fff';
  playerInfo.style.fontSize = '1.2em';
  playerInfo.style.marginBottom = '30px';
  content.appendChild(playerInfo);
  
  const buttons = document.createElement('div');
  buttons.className = 'winner-buttons';
  buttons.style.display = 'flex';
  buttons.style.gap = '20px';
  buttons.style.justifyContent = 'center';
  buttons.style.marginTop = '30px';
  
  const playAgainBtn = document.createElement('button');
  playAgainBtn.textContent = 'Play Again';
  playAgainBtn.className = 'play-again-btn';
  playAgainBtn.style.padding = '15px 30px';
  playAgainBtn.style.fontSize = '1.2em';
  playAgainBtn.style.border = 'none';
  playAgainBtn.style.borderRadius = '10px';
  playAgainBtn.style.cursor = 'pointer';
  playAgainBtn.style.background = 'linear-gradient(135deg, #e53e3e 0%, #fc8181 100%)';
  playAgainBtn.style.color = 'white';
  playAgainBtn.style.fontWeight = 'bold';
  playAgainBtn.style.transition = 'all 0.3s ease';
  playAgainBtn.addEventListener('mouseover', () => {
    playAgainBtn.style.background = 'linear-gradient(135deg, #c53030 0%, #e53e3e 100%)';
    playAgainBtn.style.transform = 'translateY(-2px)';
    playAgainBtn.style.boxShadow = '0 6px 20px rgba(229, 62, 62, 0.4)';
  });
  playAgainBtn.addEventListener('mouseout', () => {
    playAgainBtn.style.background = 'linear-gradient(135deg, #e53e3e 0%, #fc8181 100%)';
    playAgainBtn.style.transform = 'translateY(0)';
    playAgainBtn.style.boxShadow = 'none';
  });
  playAgainBtn.addEventListener('click', () => {
    console.log('Play Again clicked, checking payment status...');
    console.log('Current hasPaid status:', hasPaid);
    
    // Check payment status before allowing play again
    if (!hasPaid) {
      console.log('Payment required, showing modal...');
      showPaymentModal();
    } else {
      console.log('Payment verified, redirecting to room...');
      window.location.href = '/room/' + encodeURIComponent(currentRommId);
    }
  });
  buttons.appendChild(playAgainBtn);
  
  const lobbyBtn = document.createElement('button');
  lobbyBtn.textContent = 'Back to Lobby';
  lobbyBtn.className = 'back-lobby-btn';
  lobbyBtn.style.padding = '15px 30px';
  lobbyBtn.style.fontSize = '1.2em';
  lobbyBtn.style.border = 'none';
  lobbyBtn.style.borderRadius = '10px';
  lobbyBtn.style.cursor = 'pointer';
  lobbyBtn.style.background = 'linear-gradient(135deg, #e53e3e 0%, #fc8181 100%)';
  lobbyBtn.style.color = 'white';
  lobbyBtn.style.fontWeight = 'bold';
  lobbyBtn.style.transition = 'all 0.3s ease';
  lobbyBtn.addEventListener('mouseover', () => {
    lobbyBtn.style.background = 'linear-gradient(135deg, #c53030 0%, #e53e3e 100%)';
    lobbyBtn.style.transform = 'translateY(-2px)';
    lobbyBtn.style.boxShadow = '0 6px 20px rgba(229, 62, 62, 0.4)';
  });
  lobbyBtn.addEventListener('mouseout', () => {
    lobbyBtn.style.background = 'linear-gradient(135deg, #e53e3e 0%, #fc8181 100%)';
    lobbyBtn.style.transform = 'translateY(0)';
    lobbyBtn.style.boxShadow = 'none';
  });
  lobbyBtn.addEventListener('click', () => {
    window.location.href = '/lobby';
  });
  buttons.appendChild(lobbyBtn);
  
  content.appendChild(buttons);
  overlay.appendChild(content);
  document.body.appendChild(overlay);
});
    //Drawn Card choice
    function showDrawnCardChoice(card, isWild, callback) {
      const overlay = document.createElement('div');
      overlay.className = 'color-picker-overlay';
      overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.7)';

      const container = document.createElement('div');
      container.style.background = 'var(--surface-color, #2a2a2a)';
      container.style.padding = '24px';
      container.style.borderRadius = '16px';
      container.style.textAlign = 'center';
      container.style.maxWidth = '300px';
      container.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';

      //title
      const title = document.createElement('h2');
      title.innerText = 'You drew a playable card!';
      title.style.marginBottom = '10px';
      title.style.color = 'var(--text-color, white)';
      container.appendChild(title);

      //show card
      const cardPreview = document.createElement('div');
      cardPreview.className = 'card';
      cardPreview.dataset.cardId = fixCardId(card.id);
      cardPreview.style.margin = '0 auto 20px auto';
      cardPreview.style.transform = 'scale(1.2)';
      container.appendChild(cardPreview);

      //buttons container
      const btnContainer = document.createElement('div');
      btnContainer.style.display = 'flex';
      btnContainer.style.justifyContent = 'center';
      btnContainer.style.gap = '12px';

      //Play button
      const playBtn = document.createElement('button');
      playBtn.innerText = 'Play It';
      playBtn.className = 'btn';
      playBtn.style.padding = '12px 24px';
      playBtn.style.background = '#4CAF50';
      playBtn.style.color = 'white';
      playBtn.style.border = 'none';
      playBtn.style.borderRadius = '8px';
      playBtn.style.cursor = 'pointer';
      playBtn.addEventListener('click', () => {
        overlay.remove();
        if (isWild) {
          showColorPicker((chosenColor) => {
            callback('play', chosenColor);
          }, 'Choose color for Wild card');
        } else {
          callback('play', null);
        }
      });
      btnContainer.appendChild(playBtn);

      //keep button
      const keepBtn = document.createElement('button');
      keepBtn.innerText = 'Keep It';
      keepBtn.className = 'btn';
      keepBtn.style.padding = '12px 24px';
      keepBtn.style.background = '#2196F3';
      keepBtn.style.color = 'white';
      keepBtn.style.fontSize = '16px';
      keepBtn.style.border = 'none';
      keepBtn.style.borderRadius = '8px';
      keepBtn.style.cursor = 'pointer';
      keepBtn.addEventListener('click', () => {
        overlay.remove();
        callback('keep', null);
      });
      btnContainer.appendChild(keepBtn);

      container.appendChild(btnContainer);
      overlay.appendChild(container);
      document.body.appendChild(overlay);
    }

    // Register requestStartColor handler BEFORE joining game to avoid race condition
    socket.on('requestStartColor', ({ gameId: gid, card }) => {
        console.log('requestStartColor received, showing color picker...');
        showColorPicker((chosen) => {
          console.log('Color chosen:', chosen);
          socket.emit('startColorChosen', { gameId: gameId || 'default', color: chosen });
        }, 'Starting card is Wild!');
    });

    socket.on('drawnCardPlayable', ({ card, gameId: gid, isWild }) => {
      showDrawnCardChoice(card, isWild, (action, chosenColor) => {
        socket.emit('drawnCardChoice', {
          gameId: gameId,
          action,
          chosenColor
        });
      });
    });

    // Tell server we've opened the game page
    socket.emit('joinGame', { playerName, gameId });

    // Handle socket reconnection - automatically rejoin the game
    socket.on('connect', () => {
        console.log('Socket connected/reconnected');
        // Re-emit joinGame on reconnection to restore state
        socket.emit('joinGame', { playerName, gameId });
    });

    socket.on('disconnect', () => {
        console.log('Socket disconnected');
        document.getElementById('status').innerText = 'Connection lost. Reconnecting...';
    });

    socket.on('joined', ({ playerId, gameId }) => {
        console.log('joined', playerId, gameId);
        myPlayerId = playerId; // Store our player ID
        document.getElementById('status').innerText = `Joined game ${gameId} as ${playerName}`;
        // After first join, subsequent deals are reconnections - don't animate
        isInitialLoad = false;
    });

    socket.on('joinFailed', ({ reason }) => {
        console.error('Failed to join game:', reason);
        document.getElementById('status').innerText = `Failed to join: ${reason}`;
        alert('Failed to join game: ' + reason);
        // Redirect to lobby after a short delay
        setTimeout(() => {
            window.location.href = '/lobby';
        }, 2000);
    });

    socket.on('playerList', (players) => {
        const el = document.getElementById('playerList');
        if (el) el.innerHTML = 'Players: ' + players.map(p => {
          const badgeEmoji = getBadgeEmoji(p.selectedBadge);
          const badge = badgeEmoji ? `<span class="player-badge">${badgeEmoji}</span> ` : '';
          const titleColor = p.selectedTitleColor || 'inherit';
          return `<span id="p_${p.id}" style="color: ${titleColor}">${badge}${p.name} (${p.cardCount ?? '?'})</span>`;
        }).join(' | ');
    });

    let isInitialDeal = true;
    let currentHand = []; // Track current hand for restoring on invalid moves
    
    socket.on('deal', (hand) => {
        // Only animate on initial deal, not on reconnections
        const shouldAnimate = isInitialDeal && isInitialLoad;
        currentHand = hand; // Store the hand
        renderHand(hand, shouldAnimate);
        isInitialDeal = false;
        console.log('received deal', hand, 'animated:', shouldAnimate);
    });
    
    socket.on('gameStarted', ({currentPlayerId, players}) => {
      gameActive = true;
        currentTurnPlayerId = currentPlayerId;
        updateCurrentPlayer(currentPlayerId);
    });

    socket.on('turnChanged', ({ currentPlayerId }) => {
        currentTurnPlayerId = currentPlayerId;
        updateCurrentPlayer(currentPlayerId);
    });

    socket.on('cardPlacedOnTable', (card) => {
      currentTableCard = card; // Store current table card
      addCardToTable(card, null, 'Top of Discard Pile');
    });

    socket.on('cardPlayed', ({ playerId, playerName, card }) => {
        currentTableCard = card; // Store current table card
        addCardToTable(card, playerId, playerName);
        removeCardFromHand(card.id);
        // Update local hand tracking
        currentHand = currentHand.filter(c => c.id !== card.id);
        
        // Play sound effects based on card type
        if (card.value === 'Skip') {
          playSoundIfEnabled(getSoundPath('skip'), 0.4);
        } else if (card.value === 'Reverse') {
          playSoundIfEnabled(getSoundPath('reverse'), 0.4);
        } else if (card.value === 'Draw Two' || card.value === 'Wild Draw Four' || card.id?.includes('DrawTwo') || card.id?.includes('WildDrawFour')) {
          playSoundIfEnabled(getSoundPath('plus2'), 0.4);
        }
    });

    socket.on('invalidMove', ({ reason }) => {
        alert('Invalid move: ' + reason);
        // Re-render hand to restore any cards that were hidden during animation
        renderHand(currentHand, false);
    });

    socket.on('playerWon', ({ playerId, playerName, selectedTitle, selectedTitleColor }) => {
        const isCurrentUserWinner = (playerName === <%- JSON.stringify(user || 'Anonymous') %>);
        showWinMedal(playerName, isCurrentUserWinner, selectedTitle || 'Newbie', selectedTitleColor || 'white');
    });

    socket.on('gameEnded', (data) => {
      console.log('gameEnded', data)
      disableGameUI();
      const winner = data?.winner;
      if (winner) {
        const status = document.getElementById('status');
        status.innerText = `Game over! Winner: ${winner.name || winner.id}`;
        if (!document.querySelector('.wub-medal-overlay')) {
          const isCurrentUserWinner = (winner.name === <%- JSON.stringify(user || 'Anonymous') %>);
          showWinMedal(
            winner.name || winner.id, 
            isCurrentUserWinner, 
            winner.selectedTitle || 'Newbie', 
            winner.selectedTitleColor || 'white'
          );
        }
      }
    })

     function disableGameUI() {
      gameActive = false;
      
      // Disable draw pile
      const drawImg = document.getElementById('drawPileImg');
      if (drawImg) {
        drawImg.style.opacity = '0.5';
        drawImg.style.pointerEvents = 'none';
        drawImg.style.cursor = 'not-allowed';
      }
      
      // Disable all hand cards
      document.querySelectorAll('#hand .card, #hand div[data-card-id]').forEach(card => {
        card.style.opacity = '0.5';
        card.style.pointerEvents = 'none';
        card.style.cursor = 'not-allowed';
      });
      
      // Disable ONE button
      const oneBtn = document.getElementById('oneBtn');
      if (oneBtn) {
        oneBtn.style.opacity = '0.5';
        oneBtn.style.pointerEvents = 'none';
        oneBtn.style.cursor = 'not-allowed';
      }
      
      // Disable any other interactive elements
      document.querySelectorAll('button').forEach(btn => {
        if (!btn.closest('.win-modal')) {
          btn.disabled = true;
          btn.style.opacity = '0.5';
        }
      });
    }


    // Card Animation Functions
    function animateCardToDiscard(cardElement, cardImg) {
      return new Promise((resolve) => {
        const startRect = cardElement.getBoundingClientRect();
        const tableEl = document.getElementById('table');
        const endRect = tableEl.getBoundingClientRect();

        // Create flying card clone
        const flyingCard = document.createElement('img');
        flyingCard.src = cardImg;
        flyingCard.className = 'card-flying';
        flyingCard.style.width = cardElement.offsetWidth + 'px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Hide original card
        cardElement.style.opacity = '0';

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - cardElement.offsetWidth / 2) + 'px';
          flyingCard.style.top = (endRect.top + endRect.height / 2 - cardElement.offsetHeight / 2) + 'px';
          flyingCard.style.transform = 'scale(1.3) rotate(5deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function animateCardFromDeck() {
      return new Promise((resolve) => {
        const drawPile = document.getElementById('drawPileImg');
        const handEl = document.getElementById('hand');
        
        if (!drawPile || !handEl) {
          resolve();
          return;
        }

        const startRect = drawPile.getBoundingClientRect();
        const endRect = handEl.getBoundingClientRect();

        // Create flying card clone (card back)
        const flyingCard = document.createElement('img');
        flyingCard.src = '/img/cards/bing.png';
        flyingCard.className = 'card-flying';
        flyingCard.style.width = '85px';
        flyingCard.style.left = startRect.left + 'px';
        flyingCard.style.top = startRect.top + 'px';
        flyingCard.style.borderRadius = '8px';
        flyingCard.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
        document.body.appendChild(flyingCard);

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          flyingCard.style.left = (endRect.left + endRect.width / 2 - 42) + 'px';
          flyingCard.style.top = (endRect.top + 10) + 'px';
          flyingCard.style.transform = 'scale(1.1) rotate(-3deg)';
        });

        // Cleanup after animation
        setTimeout(() => {
          flyingCard.remove();
          resolve();
        }, 500);
      });
    }

    function renderHand(hand, animateAll = false) {
      const container = document.getElementById('hand');
      container.innerHTML = '';
      hand.forEach((card, index) => {
        const cardEl = document.createElement('div');
        cardEl.classList.add('card');
        // Fix the card id format for CSS sprite
        const fixedId = fixCardId(card.id);
        cardEl.dataset.cardId = fixedId;
        cardEl.title = `${card.name} (value ${card.value})`;
        
        // Only animate all cards on initial deal
        if (animateAll) {
          cardEl.classList.add('card-slide-in');
          cardEl.style.animationDelay = `${index * 0.05}s`;
        }
        
        cardEl.addEventListener('click', async () => {
          if (!gameActive) return;
          
          // Check if it's the player's turn BEFORE animation
          if (currentTurnPlayerId !== myPlayerId) {
            alert("It's not your turn! Wait for your turn to play.");
            return;
          }
          
          // Check if the card can be played BEFORE animation
          if (!canPlayCard(card)) {
            alert("You can't play that card! It doesn't match the color or value.");
            return;
          }
          
          // Animate card to discard pile
          await animateCardToDiscard(cardEl, card.img);
          
          // play the card
          if (card.color === 'wild') {
            showColorPicker((chosenColor) => {
              socket.emit('playCard', { gameId: gameId, cardId: card.id, chosenColor });
            });
          } else {
            socket.emit('playCard', { gameId, cardId: card.id });
          }
        });
        container.appendChild(cardEl);
      });
    }

    // Validate if a card can be played on the current table card
    function canPlayCard(card) {
      if (!currentTableCard) return true; // No table card yet, any card is valid
      
      // Wild cards can always be played
      if (card.color === 'wild') return true;
      
      // Get the active color (for wild cards that were played)
      const tableColor = currentTableCard.activeColor || currentTableCard.chosenColor || currentTableCard.color;
      const tableValue = currentTableCard.value;
      
      // Card matches if same color OR same value
      return card.color === tableColor || card.value === tableValue;
    }

    function addCardToTable(card, playerId, playerName) {
      const table = document.getElementById('table');
      //clear other cards only show top
      table.innerHTML = '';

      const wrapper = document.createElement('div');
      wrapper.style.display = 'inline-block';
      wrapper.style.textAlign = 'center';
      wrapper.style.margin = '8px';

      
      const who = document.createElement('div');
      who.innerText = playerName || (document.getElementById('p_' + playerId)?.textContent) || playerId;
      who.style.marginBottom = '4px';
      wrapper.appendChild(who);

      const cardEl = document.createElement('div');
      // Fix the card id format for CSS sprite
      const fixedId = fixCardId(card.id);
      cardEl.dataset.cardId = fixedId;
      cardEl.classList.add('card-pop', 'card'); // Add pop animation
      wrapper.appendChild(cardEl);

      const active = card.activeColor || card.chosenColor;
      if (active) {
        const badge = document.createElement('div');
        badge.innerText = `Color: ${active}`;
        badge.style.marginTop = '6px';
        badge.style.fontWeight = '600';
        wrapper.appendChild(badge);
      }

      table.appendChild(wrapper);
    }

    function removeCardFromHand(cardId) {
      // Fix the card id format for matching
      const fixedId = fixCardId(cardId);
      const cards = document.querySelectorAll('#hand div[data-card-id]');
      cards.forEach(card => {
        if (card.dataset.cardId === fixedId) card.remove();
      });
    }

     function updateCurrentPlayer(currentId, playerName) {
      const status = document.getElementById('status');
      const displayName = playerName || (document.getElementById('p_' + currentId)?.textContent) || currentId;
      status.innerText = `Current turn: ${displayName || currentId}`;
      // Highlight the player's name in playerList here
    }

    // ONE button: shows a "1" image and allows calling ONE
    const oneBtn = document.createElement('button');
    oneBtn.id = 'oneBtn';
    // Make the ONE button
    oneBtn.style.position = 'fixed';
    oneBtn.style.width = '160px';
    oneBtn.style.height = '160px';
    oneBtn.style.padding = '12px';
    oneBtn.style.display = 'flex';
    oneBtn.style.alignItems = 'center';
    oneBtn.style.justifyContent = 'center';
    oneBtn.style.borderRadius = '12px';
    // border and drop shadow so it appears cleaner
    oneBtn.style.border = 'none';
    oneBtn.style.background = 'transparent';
    oneBtn.style.boxShadow = 'none';
    oneBtn.style.cursor = 'pointer';
    oneBtn.style.zIndex = '9999';
    // place fixed in bottom-right corner 
    oneBtn.style.right = '12px';
    oneBtn.style.bottom = '12px';
    oneBtn.style.transform = 'none';
    oneBtn.style.transition = 'none';
    // If you don't have a "one" image, you can use text or a card image that represents "1".
    const oneImg = document.createElement('img');
    oneImg.src = '/img/ONElogo.png';
    oneImg.alt = 'ONE';
    oneImg.style.width = '140px';
    oneImg.style.height = '140px';
    oneImg.style.objectFit = 'contain';
    oneBtn.appendChild(oneImg);
    oneBtn.title = 'Press when you have ONE card left!';

    oneBtn.addEventListener('click', () => {
      const handCount = document.querySelectorAll('#hand div[data-card-id]').length;
      if (handCount !== 1) {
        alert('You can only call ONE when you have exactly 1 card left!');
        return;
      }
      
      // Clear the countdown timer when ONE is pressed
      if (oneCountdownInterval) {
        clearInterval(oneCountdownInterval);
        oneCountdownInterval = null;
      }
      // Clear the status message
      const s = document.getElementById('status');
      s.innerText = '';
      s.style.color = '';
      s.style.fontWeight = '';
      s.style.fontSize = '';
      // Send to server to validate and broadcast
      socket.emit('callOne', { gameId: gameId });
    });

    // Append the ONE button to the controls container (right of piles) when available,
    // otherwise try the draw pile, and finally fallback to body.
    function placeOneBtn() {
      // Always append to body when using fixed positioning so placement is predictable
      if (!document.body.contains(oneBtn)) document.body.appendChild(oneBtn);
    }
    placeOneBtn();

    // Create custom notification function for ONE calls (doesn't trigger alert sound)
    function showOneNotification(message) {
        const notification = document.createElement('div');
        notification.textContent = message;
        notification.style.cssText = `
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #f0c030 0%, #f39c12 100%);
            color: #1a1a1a;
            padding: 20px 40px;
            border-radius: 16px;
            font-size: 1.5rem;
            font-weight: 800;
            box-shadow: 0 8px 30px rgba(0,0,0,0.5);
            z-index: 10000;
            animation: popIn 0.3s ease-out;
        `;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transition = 'opacity 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 2000);
    }

    // Global handler for transfer button (called by inline onclick)
    window.handleTransferClick = async function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Transfer button workie!');
        await doTransfer();
    };
    
    // Payment modal functions
    let paymentHandlerAttached = false; // Track if handler is already attached
    
    window.showPaymentModal = async function () {
        console.log(' showPaymentModal called');
        const modal = document.getElementById('paymentModal');
        if (!modal) {
            console.error('Payment modal element not found!');
            return;
        }
        
        // Hide the winner modal so it doesn't block clicks
        const winnerOverlay = document.querySelector('.win-modal-overlay');
        if (winnerOverlay) {
            winnerOverlay.style.display = 'none';
        }
        
        modal.style.display = 'block';
        console.log('✅ Payment modal displayed');
    };

    window.hidePaymentModal = function () {
        const modal = document.getElementById('paymentModal');
        if (modal) modal.style.display = 'none';
    };

    // Listen for payment success
    window.addEventListener('paymentSuccess', () => {
        console.log('💳 Payment successful! Refreshing status and redirecting...');
        hidePaymentModal();
        hasPaid = true;
        // Redirect to lobby after successful payment
        setTimeout(() => {
            window.location.href = '/lobby';
        }, 300);
    });

    window.addEventListener('hidePaymentModal', () => {
        hidePaymentModal();
    });

    // Listen for server confirmation / errors
    socket.on('playerCalledOne', ({ playerId, playerName }) => {
      const name = playerName || document.getElementById('p_' + playerId)?.textContent || playerId;
      showOneNotification(name + ' called ONE!');
    });

    socket.on('oneCallFailedToEarly', ({ playerId }) => {
      alert('You cannot call ONE yet! You have more than 1 card.');
    });

    socket.on('drawPenalty', ({ playerId, playerName, count, reason }) => {
      const name = playerName || document.getElementById('p_' + playerId)?.textContent || playerId;
      if (reason === 'missedOne') {
        alert(name + ' failed to call ONE and drew ' + count + ' penalty card' + (count !== 1 ? 's' : ''));
      } else if (reason === 'timeout') {
        alert(name + ' failed to call ONE in time and drew ' + count + ' card' + (count !== 1 ? 's' : ''));
      } else {
        alert(name + ' drew ' + count + ' penalty card' + (count !== 1 ? 's' : ''));
      }
    });

    // Notify the player when they have ONE card and need to call it
    let oneCountdownInterval = null;
    socket.on('youHaveOne', ({ expiresAt }) => {
      const s = document.getElementById('status');
      
      // Clear any existing countdown
      if (oneCountdownInterval) {
        clearInterval(oneCountdownInterval);
        oneCountdownInterval = null;
      }
      
      // Create a span for the number so we can update just the number
      const baseText = 'You have ONE card! Press the ONE button within ';
      const endText = ' seconds!';
      
      // Update countdown every 1 second for easier readability
      function updateCountdown() {
        const remainMs = Math.max(0, expiresAt - Date.now());
        const secs = Math.ceil(remainMs / 1000);
        
        if (secs > 0) {
          s.innerHTML = baseText + '<span id="oneCountdown" style="font-size: 1.4em; font-weight: bold;">' + secs + '</span>' + endText;
          s.style.color = secs <= 2 ? '#ff4444' : '#ffaa00';
          s.style.fontWeight = 'bold';
          s.style.fontSize = '1.2em';
        } else {
          s.innerText = '';
          s.style.color = '';
          s.style.fontWeight = '';
          s.style.fontSize = '';
          if (oneCountdownInterval) {
            clearInterval(oneCountdownInterval);
            oneCountdownInterval = null;
          }
        }
      }
      
      // Initial update
      updateCountdown();
      
      // Update every 1 second (1000ms)
      oneCountdownInterval = setInterval(updateCountdown, 1000);
    });


// Create draw pile UI 
const drawContainer = document.createElement('div');
drawContainer.id = 'drawPile';
drawContainer.style.display = 'inline-block';
drawContainer.style.textAlign = 'center';
drawContainer.style.margin = '8px';

// count badge (placed above the draw image)
const drawCount = document.createElement('div');
drawCount.id = 'drawCount';
drawCount.style.marginBottom = '6px';
drawCount.style.fontWeight = '600';
drawCount.innerText = ''; 
drawContainer.appendChild(drawCount);

// draw pile image - using card back
const drawImg = document.createElement('img');
drawImg.id = 'drawPileImg';
drawImg.src = '/img/cards/bing.png';
drawImg.alt = 'Draw Pile';
drawImg.title = 'Click to draw a card';
drawContainer.appendChild(drawImg);

// Place the draw pile and ensure the discard #table sit together inside #tableArea
const tableArea = document.getElementById('tableArea');
const tableEl = document.getElementById('table');

// Create a controls column (right side) to hold buttons like ONE
const controlContainer = document.createElement('div');
controlContainer.id = 'tableControls';
controlContainer.style.display = 'flex';
controlContainer.style.flexDirection = 'column';
controlContainer.style.alignItems = 'center';
controlContainer.style.minWidth = '80px';
controlContainer.style.margin = '8px';

// Append draw pile, table (discard), then controls to tableArea to form left->center->right
tableArea.appendChild(drawContainer);
if (tableEl.parentNode !== tableArea) {
  tableArea.appendChild(tableEl);
}
tableArea.appendChild(controlContainer);

// Force ordering: discard (table) left, draw pile center, controls right
tableEl.style.order = '1';
drawContainer.style.order = '2';
controlContainer.style.order = '3';

// Clicking the draw pile
drawImg.addEventListener('click', async () => {
  // Check if it's the player's turn BEFORE animation
  if (currentTurnPlayerId !== myPlayerId) {
    alert("It's not your turn! Wait for your turn to draw.");
    return;
  }
  
  // Animate card from deck to hand
  await animateCardFromDeck();
  socket.emit('drawCard', { gameId: gameId });
});

// Update draw pile count when server tells us
socket.on('drawPileCount', ({ count }) => {
  const el = document.getElementById('drawCount');
  el.innerText = `Deck: ${count}`;
});

//  show a notification when any player draws
socket.on('playerDrew', ({ playerId, count }) => {
  const name = document.getElementById('p_' + playerId)?.textContent || playerId;
  const s = document.getElementById('status');
  s.innerText = `${name} drew ${count} card${count !== 1 ? 's' : ''}`;
});
</script>
</html>
