    socket.on('playerCalledOne', ({ playerId, playerName }) => {
      const name = playerName || document.getElementById('p_' + playerId)?.textContent || playerId;
      showOneNotification(name + ' called ONE!');
    });

    socket.on('oneCallFailedToEarly', ({ playerId }) => {
      alert('You cannot call ONE yet! You have more than 1 card.');
    });

    socket.on('drawPenalty', ({ playerId, playerName, count, reason }) => {
      const name = playerName || document.getElementById('p_' + playerId)?.textContent || playerId;
      if (reason === 'missedOne') {
        alert(name + ' failed to call ONE and drew ' + count + ' penalty card' + (count !== 1 ? 's' : ''));
      } else if (reason === 'timeout') {
        alert(name + ' failed to call ONE in time and drew ' + count + ' card' + (count !== 1 ? 's' : ''));
      } else {
        alert(name + ' drew ' + count + ' penalty card' + (count !== 1 ? 's' : ''));
      }
    });

    // Notify the player when they have ONE card and need to call it
    let oneCountdownInterval = null;
    socket.on('youHaveOne', ({ expiresAt }) => {
      const s = document.getElementById('status');
      
      // Clear any existing countdown
      if (oneCountdownInterval) {
        clearInterval(oneCountdownInterval);
        oneCountdownInterval = null;
      }
      
      // Create a span for the number so we can update just the number
      const baseText = 'You have ONE card! Press the ONE button within ';
      const endText = ' seconds!';
      
      // Update countdown every 1 second for easier readability
      function updateCountdown() {
        const remainMs = Math.max(0, expiresAt - Date.now());
        const secs = Math.ceil(remainMs / 1000);
        
        if (secs > 0) {
          s.innerHTML = baseText + '<span id="oneCountdown" style="font-size: 1.4em; font-weight: bold;">' + secs + '</span>' + endText;
          s.style.color = secs <= 2 ? '#ff4444' : '#000000';
          s.style.fontWeight = 'bold';
          s.style.fontSize = '1.2em';
        } else {
          s.innerText = '';
          s.style.color = '';
          s.style.fontWeight = '';
          s.style.fontSize = '';
          if (oneCountdownInterval) {
            clearInterval(oneCountdownInterval);
            oneCountdownInterval = null;
          }
        }
      }
      
      // Initial update
      updateCountdown();
      
      // Update every 1 second 
      oneCountdownInterval = setInterval(updateCountdown, 1000);
    });


// Create draw pile UI 
const drawContainer = document.createElement('div');
drawContainer.id = 'drawPile';
drawContainer.style.display = 'inline-block';
drawContainer.style.textAlign = 'center';
drawContainer.style.margin = '8px';

// count badge 
const drawCount = document.createElement('div');
drawCount.id = 'drawCount';
drawCount.style.marginBottom = '6px';
drawCount.style.fontWeight = '600';
drawCount.innerText = ''; 
drawContainer.appendChild(drawCount);

// draw pile image 
const drawImg = document.createElement('img');
drawImg.id = 'drawPileImg';
drawImg.src = '/img/cards/bing.png';
drawImg.alt = 'Draw Pile';
drawImg.title = 'Click to draw a card';
drawContainer.appendChild(drawImg);

// Place the draw pile and ensure the discard #table sit together inside #tableArea
const tableArea = document.getElementById('tableArea');
const tableEl = document.getElementById('table');

// Create a controls column (right side) to hold buttons like ONE
const controlContainer = document.createElement('div');
controlContainer.id = 'tableControls';
controlContainer.style.display = 'flex';
controlContainer.style.flexDirection = 'column';
controlContainer.style.alignItems = 'center';
controlContainer.style.minWidth = '80px';
controlContainer.style.margin = '8px';

// Append draw pile, table (discard), then controls to tableArea to form left->center->right
tableArea.appendChild(drawContainer);
if (tableEl.parentNode !== tableArea) {
  tableArea.appendChild(tableEl);
}
tableArea.appendChild(controlContainer);

// Force ordering: discard (table) left, draw pile center, controls right
tableEl.style.order = '1';
drawContainer.style.order = '2';
controlContainer.style.order = '3';

// Clicking the draw pile
drawImg.addEventListener('click', async () => {
  // Check if it's the player's turn BEFORE animation
  if (currentTurnPlayerId !== myPlayerId) {
    alert("It's not your turn! Wait for your turn to draw.");
    return;
  }
  
  // If there's a draw stack active, confirm the player wants to draw
  if (currentDrawStack > 0) {
    const confirmDraw = confirm(` STACKING ACTIVE\n\nYou will draw ${currentDrawStack} cards from the stack.\n\nYou can also play a +2 or +4 card to add to the stack!\n(Note: You can only stack equal or higher values)\n\nDraw ${currentDrawStack} cards?`);
    if (!confirmDraw) {
      return;
    }
  }
  
  // Trigger sparkles if equipped
  if (userSelectedEffects.includes('sparkles')) {
    triggerDrawPileSparkles();
  }
  
  // Animate card from deck to hand
  await animateCardFromDeck();
  socket.emit('drawCard', { gameId: gameId });
});

// Update draw pile count when server tells us
socket.on('drawPileCount', ({ count }) => {
  const el = document.getElementById('drawCount');
  // Only update if there's no active draw stack
  if (currentDrawStack === 0) {
    el.innerText = `Deck: ${count}`;
  }
});

// Update draw stack display for stacking rule
socket.on('drawStackUpdated', ({ drawStack }) => {
  currentDrawStack = drawStack; // Update global tracker
  
  const statusEl = document.getElementById('status');
  const drawPileImg = document.getElementById('drawPileImg');
  const drawCount = document.getElementById('drawCount');
  
  if (drawStack > 0) {
    statusEl.innerHTML = `<span style="color: #f85149; font-weight: bold;"> Play a +2/+4 to add to the stack or draw ${drawStack} cards!</span>`;
    
    // Add visual indicator to draw pile
    if (drawPileImg) {
      drawPileImg.style.border = '3px solid #f85149';
      drawPileImg.style.boxShadow = '0 0 20px rgba(248, 81, 73, 0.6)';
      drawPileImg.title = `Click to draw ${drawStack} cards from the stack`;
    }
    
    //  draw count Stacking 
    if (drawCount) {
      drawCount.innerHTML = `
        <div style="
          background: linear-gradient(135deg, #f85149 0%, #d43f3a 100%);
          color: white;
          padding: 8px 16px;
          border-radius: 8px;
          font-weight: bold;
          font-size: 16px;
          box-shadow: 0 4px 15px rgba(248, 81, 73, 0.4);
          display: inline-block;
          min-width: 120px;
          text-align: center;
        ">
          <div style="font-size: 12px; opacity: 0.9; margin-bottom: 2px;">STACKING</div>
          <div style="font-size: 24px;">+${drawStack}</div>
        </div>
      `;
    }
  } else {
    statusEl.innerText = '';
    
    //  visual indicator draw pile
    if (drawPileImg) {
      drawPileImg.style.border = '';
      drawPileImg.style.boxShadow = '';
      drawPileImg.title = 'Click to draw a card';
    }
  }
});

// Show notification when any player draws
socket.on('playerDrew', ({ playerId, count }) => {
  const playerElement = document.getElementById('p_' + playerId);
  const name = playerElement?.textContent || playerId;
  const s = document.getElementById('status');
  s.innerText = `${name} drew ${count} card${count !== 1 ? 's' : ''}`;
  
  // Update card count in player list
  if (playerElement) {
    const currentText = playerElement.textContent;
    const match = currentText.match(/(.+)\s\((\d+)\)/);
    if (match) {
      const playerName = match[1];
      const currentCount = parseInt(match[2]);
      const newCount = currentCount + count;
      // Extract the badge part (everything before the player name)
      const fullHTML = playerElement.innerHTML;
      const badgeMatch = fullHTML.match(/^(<span[^>]*>.*?<\/span>\s*)?/);
      const badge = badgeMatch ? badgeMatch[0] : '';
      playerElement.innerHTML = badge + playerName + ' (' + newCount + ')';
    }
  }
});

// Show notification when any player draws cards (including from stack)
socket.on('playerDrewCards', ({ playerId, count }) => {
  const playerElement = document.getElementById('p_' + playerId);
  const name = playerElement?.textContent || playerId;
  const s = document.getElementById('status');
  if (count > 1) {
    s.innerHTML = `<span style="color: #ff6b6b; font-weight: bold;">${name} drew ${count} cards from the stack!</span>`;
  } else {
    s.innerText = `${name} drew ${count} card`;
  }
  
  // Update card count in player list
  if (playerElement) {
    const currentText = playerElement.textContent;
    const match = currentText.match(/(.+)\s\((\d+)\)/);
    if (match) {
      const playerName = match[1];
      const currentCount = parseInt(match[2]);
      const newCount = currentCount + count;
      // Extract the badge part (everything before the player name)
      const fullHTML = playerElement.innerHTML;
      const badgeMatch = fullHTML.match(/^(<span[^>]*>.*?<\/span>\s*)?/);
      const badge = badgeMatch ? badgeMatch[0] : '';
      playerElement.innerHTML = badge + playerName + ' (' + newCount + ')';
    }
  }
  
  // Play draw sound if enabled
  playSoundIfEnabled(getSoundPath('draw'), 0.3);
});
</script>
</html>
