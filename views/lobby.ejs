<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Lobby List</title>
    <link rel="icon" type="image/x-icon" href="/img/pfp.png">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/lobby.css">
</head>
<body>
    <a href="/" class="btn home-button">Home</a>
    <a href="/logout" class="btn logout-button">Logout</a>
    
    <!-- Emoji Reaction Button (upper-left, shown when in room) -->
    <button class="emoji-reaction-button" id="emojiReactionBtn" onclick="toggleEmojiMenu()" style="display: none;">😊</button>
    
    <!-- Emoji Selection Menu -->
    <div class="emoji-menu" id="emojiMenu" style="display: none;">
        <div class="emoji-menu-item" data-emoji="0"></div>
        <div class="emoji-menu-item" data-emoji="1"></div>
        <div class="emoji-menu-item" data-emoji="2"></div>
        <div class="emoji-menu-item" data-emoji="3"></div>
    </div>
    
    <!-- Emoji Reactions Display Area -->
    <div class="emoji-reactions-area" id="emojiReactionsArea"></div>
    
    <div class="lobby-container">
        <h1 class="lobby-title">Game Lobby</h1>
        
        <div class="lobby-panel" id="lobbiesContainer">
            <div class="panel-header">
                <h2>Available Lobbies</h2>
            </div>
            <div id="lobbyList">
                <div class="loading-text">Loading lobbies...</div>
            </div>
        </div>

        <div class="lobby-panel" id="createLobby">
            <div class="panel-header">
                <h2>Create New Lobby</h2>
            </div>
            <div class="lobby-form">
                <input type="text" id="createLobbyName" placeholder="Enter lobby name..." />
                <input type="number" id="createMaxPlayers" min="2" max="32" value="8" title="Max Players" />
                <div class="checkbox-wrapper">
                    <input type="checkbox" id="createPrivateLobby" />
                    <label for="createPrivateLobby">Private</label>
                </div>
                <button id="createLobbyBtn">Create Lobby</button>
            </div>
        </div>

        <div class="lobby-panel" id="joinByCode">
            <div class="panel-header">
                <h2>Join Private Lobby</h2>
            </div>
            <div class="lobby-form">
                <input type="text" id="joinLobbyCode" placeholder="Enter private lobby code..." />
                <button id="joinByCodeBtn">Join</button>
            </div>
        </div>

        <div class="lobby-panel" id="currentRoom">
            <h2 id="currentRoomTitle">Room</h2>
            <div id="currentRoomInfo"></div>
            <div id="roomPlayerList"></div>
            <div id="roomControls"></div>
            <button id="leaveLobbyBtn">Leave Lobby</button>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="paymentModal" class="payment-modal" style="display: none;">
        <div class="payment-modal-content">
            <span class="payment-modal-close" onclick="hidePaymentModal()">&times;</span>
            <%- include('partials/pay') %>
        </div>
    </div>

    <script>window.CURRENT_USER = "<%= user %>";</script>
    <script>
        // Pass selected emotes to JavaScript
        document.body.setAttribute('data-selected-emotes', '<%- typeof selectedEmotes !== "undefined" ? selectedEmotes : "[]" %>');
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/lobby.js"></script>
</body>
</html>