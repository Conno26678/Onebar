<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#f85149">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Onebar">
    <link rel="manifest" href="/manifest.json">
    <title>Onebar - Home</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/mobile.css">
</head>
<body>
    <a href="/logout" class="btn logout-button">Logout</a>
    
    <div class="home-container">
        <h1 class="home-title">Welcome to Onebar!</h1>
        <img src="/img/ONElogo.png" alt="Onebar Logo" width="200" class="home-logo">
        <h3 class="home-subtitle">Select a game to join.</h3>
        
        <nav class="home-nav">
            <a href="/lobby">Lobby List</a>
            <a href="/about">About / Rules</a>
            <a href="/leaderboard">Leaderboard</a>
            <a href="/profile">Profile</a>
            <a href="/shop">Shop</a>
        </nav>
    </div>
    
    <script src="/js/theme.js"></script>
    <script>
        // Sound control helper function
        function playSoundIfEnabled(soundPath, volume = 0.5) {
            const soundEnabled = localStorage.getItem('soundEffectsEnabled');
            if (soundEnabled === 'false') {
                console.log('Sound disabled, skipping:', soundPath);
                return null;
            }
            const audio = new Audio(soundPath);
            audio.volume = volume;
            audio.play().catch(err => console.log('Sound play failed:', err));
            return audio;
        }

        // Play hello there sound only on first visit
        const hasPlayedHello = sessionStorage.getItem('helloPlayed');
        
        if (!hasPlayedHello) {
            let audioPlayed = false;
            const soundEnabled = localStorage.getItem('soundEffectsEnabled');
            
            if (soundEnabled !== 'false') {
                const audio = new Audio('/sfx/hellothere.mp3');
                audio.volume = 0.5;
                
                // Try to play immediately
                audio.play().then(() => {
                    sessionStorage.setItem('helloPlayed', 'true');
                }).catch(err => {
                    console.log('Audio autoplay prevented, waiting for user interaction');
                    // If autoplay fails, play on first user interaction
                    const playOnInteraction = () => {
                        if (!audioPlayed) {
                            audio.play().then(() => {
                                sessionStorage.setItem('helloPlayed', 'true');
                            }).catch(e => console.log('Audio play failed:', e));
                            audioPlayed = true;
                            document.removeEventListener('click', playOnInteraction);
                            document.removeEventListener('keydown', playOnInteraction);
                        }
                    };
                    document.addEventListener('click', playOnInteraction, { once: true });
                    document.addEventListener('keydown', playOnInteraction, { once: true });
                });
            }
        }

        // Register Service Worker for PWA
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('ServiceWorker registered:', registration.scope);
                    })
                    .catch(error => {
                        console.log('ServiceWorker registration failed:', error);
                    });
            });
        }

        // Install prompt for PWA
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            // Prevent the mini-infobar from appearing on mobile
            e.preventDefault();
            // Stash the event so it can be triggered later
            deferredPrompt = e;
            console.log('Install prompt available');
            
            // Show custom install button if desired
            // You can add a custom "Install App" button here
        });

        window.addEventListener('appinstalled', () => {
            console.log('PWA was installed');
            deferredPrompt = null;
        });
    </script>
</body>
</html>