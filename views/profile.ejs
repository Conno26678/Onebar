                rewardIcon.textContent = '🎉';
                rewardDetails.innerHTML = '<span style="color: #4CAF50;">✨ New item unlocked!</span>';
                if (reward.type === 'customSound') {
                    rewardDetails.innerHTML += '<br><em>Equip the Custom sound pack to use it!</em>';
