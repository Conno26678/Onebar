<!DOCTYPE html>
<html lang="en" data-theme="<%= selectedTheme || 'default' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#f85149">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <title>Onebar - Private Room</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/room.css">
    <link rel="stylesheet" href="/css/mobile.css">
</head>
<body>
    <a href="/" class="btn home-button">Home</a>
    <a href="/logout" class="btn logout-button">Logout</a>
    
    <div class="room-container">
        <h1 class="room-title" id="roomTitle"> Private Room</h1>
        
        <div class="join-code-container" id="joinCodeContainer">
            <div class="join-code-box">
                <span class="join-code-label">Share This Code</span>
                <span class="join-code" id="roomJoinCodeDisplay" title="Click to copy"></span>
                <span class="copy-hint">Click to copy</span>
            </div>
        </div>
        
        <div class="room-panel">
            <div id="roomInfo"></div>
            
            <div class="section-header">
                <h3> Players</h3>
            </div>
            <div id="roomPlayerList">
                <div class="waiting-indicator">Waiting for players<span class="dots">...</span></div>
            </div>
            
            <div id="roomControls"></div>
            
            <button id="leaveRoomBtn">Leave Room</button>
        </div>
    </div>

    <!-- XP Notification Box -->
    <div id="xpNotification" class="xp-notification" style="display: none;">
        <div class="xp-notification-header">Level Up Progress</div>
        <div class="xp-notification-content">
            <div class="xp-notification-row">
                <span class="xp-notification-label">Player:</span>
                <span class="xp-notification-value" id="xpNotifPlayerName"></span>
            </div>
            <div class="xp-notification-row">
                <span class="xp-notification-label">Level:</span>
                <span class="xp-notification-value" id="xpNotifLevel"></span>
            </div>
            <div class="xp-notification-row xp-earned-row">
                <span class="xp-notification-label">XP Earned:</span>
                <span class="xp-notification-value xp-earned" id="xpNotifEarned"></span>
            </div>
        </div>
    </div>

    <!-- Winner Modal -->
    <div id="winnerModal" class="winner-modal" style="display: none;">
        <div class="winner-modal-content">
            <div class="winner-trophy">🏆</div>
            <h2 class="winner-title">Game Over!</h2>
            <div class="winner-name" id="winnerNameDisplay"></div>
            <div class="winner-earnings" id="winnerEarningsDisplay"></div>
            <div class="winner-buttons">
                <button id="playAgainBtn" class="winner-btn primary">Play Again</button>
                <button id="backToLobbyBtn" class="winner-btn secondary">Back to Lobby</button>
            </div>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="paymentModal" class="payment-modal" style="display: none;">
        <div class="payment-modal-content">
            <span class="payment-modal-close" onclick="hidePaymentModal()">&times;</span>
            <%- include('partials/pay') %>
        </div>
    </div>

    <script>window.CURRENT_USER = "<%= user %>"; window.GAME_ID = "<%= gameId %>"; window.LOBBY_NAME = "<%= (typeof lobbyName !== 'undefined' ? lobbyName : '') %>";</script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
    <script>
        // Sound pack mapping
        const soundMappings = {
            default: {
                loading: '/sfx/loading.mp3',
                startgame: '/sfx/afewmoments.mp3'
            },
            hayden: {
                loading: '/sfx/loading.mp3',
                startgame: '/sfx/haydenstartgame.mp3'
            }
        };

        // Function to get current sound pack
        function getCurrentSoundPack() {
            return localStorage.getItem('selectedSoundPack') || 'default';
        }

        // Function to get sound path based on selected pack
        function getSoundPath(soundType) {
            const pack = getCurrentSoundPack();
            return soundMappings[pack]?.[soundType] || soundMappings.default[soundType];
        }

        // Sound control helper function
        function playSoundIfEnabled(soundPath, volume = 0.5) {
            const soundEnabled = localStorage.getItem('soundEffectsEnabled');
            if (soundEnabled === 'false') {
                console.log('Sound disabled, skipping:', soundPath);
                return null;
            }
            const audio = new Audio(soundPath);
            audio.volume = volume;
            audio.play().catch(err => console.log('Sound play failed:', err));
            return audio;
        }

        // Play "a few moments" sound on page load
        playSoundIfEnabled(getSoundPath('startgame'), 0.5);
        
        // Override alert to play loading sound
        const originalAlert = window.alert;
        window.alert = function(message) {
            playSoundIfEnabled(getSoundPath('loading'), 0.5);
            originalAlert.call(window, message);
        };
    </script>
    <script src="/js/room.js?v=4"></script>
</body>
</html>