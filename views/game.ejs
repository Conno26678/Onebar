drawImg.addEventListener('click', async () => {
  // Check if it's the player's turn BEFORE animation
  if (currentTurnPlayerId !== myPlayerId) {
    alert("It's not your turn! Wait for your turn to draw.");
    return;
  }
  
  // Trigger sparkles if equipped
  if (userSelectedEffects.includes('sparkles')) {
    triggerDrawPileSparkles();
  }
  
  // Animate card from deck to hand
  await animateCardFromDeck();
  socket.emit('drawCard', { gameId: gameId });
});

// Update draw pile count when server tells us
socket.on('drawPileCount', ({ count }) => {
  const el = document.getElementById('drawCount');
  el.innerText = `Deck: ${count}`;
});

//  show a notification when any player draws
socket.on('playerDrew', ({ playerId, count }) => {
  const name = document.getElementById('p_' + playerId)?.textContent || playerId;
  const s = document.getElementById('status');
  s.innerText = `${name} drew ${count} card${count !== 1 ? 's' : ''}`;
});
</script>
</html>
