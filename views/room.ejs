<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Private Room</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Room Page Specific Styles */
        .room-container {
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
            padding-top: 80px;
            min-height: 100vh;
        }

        .room-title {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-color), #ff6b6b, var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 25px;
            letter-spacing: 2px;
            animation: titleGlow 3s ease-in-out infinite;
        }

        @keyframes titleGlow {
            0%, 100% { filter: brightness(1); }
            50% { filter: brightness(1.2); }
        }

        /* Join Code Display */
        .join-code-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .join-code-box {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            border: 2px solid var(--border-color);
            border-radius: 16px;
            padding: 20px 40px;
            box-shadow: 0 8px 30px var(--shadow), inset 0 1px 0 rgba(255,255,255,0.1);
            position: relative;
            overflow: hidden;
        }

        .join-code-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-color), var(--primary-color));
            border-radius: 16px 16px 0 0;
        }

        .join-code-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .join-code {
            font-size: 2rem;
            font-weight: 800;
            font-family: 'Courier New', monospace;
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 4px;
            user-select: all;
            cursor: pointer;
        }

        .copy-hint {
            font-size: 0.75rem;
            color: var(--secondary-color);
            margin-top: 8px;
            opacity: 0.7;
        }

        /* Room Panel */
        .room-panel {
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 8px 30px var(--shadow), inset 0 1px 0 rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .room-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
            border-radius: 16px 16px 0 0;
        }

        /* Room Info */
        #roomInfo {
            text-align: center;
            margin-bottom: 20px;
            padding: 15px;
            background: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        #roomInfo .info-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0 15px;
            font-weight: 600;
            color: var(--text-color);
        }

        #roomInfo .info-badge {
            background: linear-gradient(135deg, var(--primary-color), #ff6b6b);
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.85rem;
        }

        /* Player List */
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 20px 0 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid transparent;
            border-image: linear-gradient(90deg, var(--primary-color), var(--accent-color), transparent) 1;
        }

        .section-header h3 {
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
            background: linear-gradient(135deg, var(--text-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-header::before {
            content: '';
            width: 4px;
            height: 20px;
            background: linear-gradient(180deg, var(--primary-color), var(--accent-color));
            border-radius: 2px;
        }

        #roomPlayerList {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            padding: 20px;
            background: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            min-height: 80px;
        }

        #roomPlayerList .player-tag {
            background: linear-gradient(135deg, var(--card-bg) 0%, var(--hover-color) 100%);
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
            border: 2px solid var(--border-color);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #roomPlayerList .player-tag:hover {
            transform: translateY(-3px);
            border-color: var(--primary-color);
            box-shadow: 0 6px 20px var(--shadow);
        }

        #roomPlayerList .player-tag.host {
            border-color: var(--accent-color);
            background: linear-gradient(135deg, var(--accent-color), #68d391);
            color: white;
            box-shadow: 0 4px 15px rgba(56, 161, 105, 0.3);
        }

        #roomPlayerList .player-tag .host-badge {
            background: rgba(255,255,255,0.3);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Waiting Indicator */
        .waiting-indicator {
            text-align: center;
            padding: 20px;
            color: var(--secondary-color);
            font-style: italic;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .waiting-indicator .dots {
            display: inline-block;
            animation: dots 1.5s steps(4, end) infinite;
        }

        @keyframes dots {
            0%, 20% { content: ''; }
            40% { content: '.'; }
            60% { content: '..'; }
            80%, 100% { content: '...'; }
        }

        /* Room Controls */
        #roomControls {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 25px 0;
        }

        #roomControls button {
            padding: 14px 28px;
            background: var(--gradient-primary);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px var(--shadow);
            position: relative;
            overflow: hidden;
        }

        #roomControls button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }

        #roomControls button:hover::before {
            left: 100%;
        }

        #roomControls button:hover {
            background: var(--gradient-accent);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px var(--shadow), var(--glow-accent);
        }

        #roomControls button.start-btn {
            background: var(--gradient-accent);
            font-size: 1.1rem;
            padding: 16px 36px;
        }

        #roomControls button.start-btn:hover {
            background: var(--gradient-primary);
            box-shadow: 0 8px 25px var(--shadow), var(--glow-primary);
        }

        /* Leave Button */
        #leaveRoomBtn {
            display: block;
            width: 100%;
            padding: 14px;
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
        }

        #leaveRoomBtn:hover {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 4px 20px rgba(229, 62, 62, 0.3);
        }

        /* Animations */
        .fade-in {
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .room-container {
                padding: 15px;
                padding-top: 70px;
            }

            .room-title {
                font-size: 1.6rem;
            }

            .join-code {
                font-size: 1.5rem;
            }

            .join-code-box {
                padding: 15px 25px;
            }

            #roomControls {
                flex-direction: column;
            }

            #roomControls button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <a href="/logout" class="btn logout-button">Logout</a>
    
    <div class="room-container">
        <h1 class="room-title" id="roomTitle"> Private Room</h1>
        
        <div class="join-code-container" id="joinCodeContainer">
            <div class="join-code-box">
                <span class="join-code-label">🔐 Share This Code</span>
                <span class="join-code" id="roomJoinCodeDisplay" title="Click to copy"></span>
                <span class="copy-hint">Click to copy</span>
            </div>
        </div>
        
        <div class="room-panel">
            <div id="roomInfo"></div>
            
            <div class="section-header">
                <h3>👥 Players</h3>
            </div>
            <div id="roomPlayerList">
                <div class="waiting-indicator">Waiting for players<span class="dots">...</span></div>
            </div>
            
            <div id="roomControls"></div>
            
            <button id="leaveRoomBtn">🚪 Leave Room</button>
        </div>
    </div>

    <script>window.CURRENT_USER = "<%= user %>"; window.GAME_ID = "<%= gameId %>"; window.LOBBY_NAME = "<%= (typeof lobbyName !== 'undefined' ? lobbyName : '') %>";</script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/room.js"></script>
</body>
</html>