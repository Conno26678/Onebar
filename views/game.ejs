    // Initialize distraction menu items
    function initDistractionMenu() {
      const menu = document.getElementById('distractionMenu');
      menu.innerHTML = ''; // Clear existing items
      
      const hasDistractions = Object.keys(distractionsInventory).length > 0;
      
      if (!hasDistractions) {
        menu.innerHTML = '<div class="distraction-menu-empty">No distractions available!<br>Purchase some in the shop</div>';
        return;
      }
      
      // Add each distraction type with count
      Object.entries(distractionsInventory).forEach(([type, count]) => {
        if (count > 0) {
          const distraction = availableDistractions.find(d => d.id === type);
          if (distraction) {
            const item = document.createElement('div');
            item.className = 'distraction-menu-item';
            item.innerHTML = `
              <span class="distraction-icon">${distraction.icon}</span>
              <span class="distraction-name">${distraction.name}</span>
              <span class="distraction-count">×${count}</span>
            `;
            item.onclick = () => useDistraction(type, distraction.icon, distraction.name);
            menu.appendChild(item);
          }
        }
      });
    }
    
    // Toggle distraction menu visibility
    function toggleDistractionMenu() {
      const menu = document.getElementById('distractionMenu');
      if (menu.style.display === 'none') {
        initDistractionMenu(); // Refresh menu each time it opens
        menu.style.display = 'flex';
      } else {
        menu.style.display = 'none';
      }
    }
    
    // Use a distraction
    function useDistraction(type, icon, name) {
      if (!distractionsInventory[type] || distractionsInventory[type] <= 0) {
        alert('You have no ' + name + ' distractions left!');
        return;
      }
      
      // Warn about mobile users not seeing the effect
      const isMobile = window.innerWidth <= 768;
      if (!isMobile) {
        const proceed = confirm('Note: Mobile users cannot see distraction effects.\n\nDo you want to use this distraction?');
        if (!proceed) {
          return;
        }
      }
      
      // Send distraction to server and other players
      socket.emit('useDistraction', {
        gameId,
        playerName,
        distractionType: type,
        distractionIcon: icon,
        distractionName: name
      });
      
      // Optimistically update local count
      distractionsInventory[type]--;
      if (distractionsInventory[type] <= 0) {
        delete distractionsInventory[type];
      }
      
      toggleDistractionMenu();
    }
    
    // Close menus when clicking outside
    document.addEventListener('click', (e) => {
      const emojiMenu = document.getElementById('emojiMenu');
      const emojiBtn = document.getElementById('emojiReactionBtn');
      if (emojiMenu && emojiBtn && !emojiMenu.contains(e.target) && !emojiBtn.contains(e.target)) {
        emojiMenu.style.display = 'none';
      }
      
      const distractionMenu = document.getElementById('distractionMenu');
      const distractionBtn = document.getElementById('distractionBtn');
      if (distractionMenu && distractionBtn && !distractionMenu.contains(e.target) && !distractionBtn.contains(e.target)) {
        distractionMenu.style.display = 'none';
      }
    });
    
