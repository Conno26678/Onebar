<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onebar - Battle Pass</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/battlepass.css">
</head>
<body>
    <a href="/" class="btn home-button">Home</a>
    <a href="/logout" class="btn logout-button">Logout</a>
    
    <h2>Battle Pass - Season 0</h2>
    <p>Level up to earn rewards and purchase the premium pass to unlock more benefits and cool rewards, with some free goodies sprinkled in.</p>
    
    <!-- Player Progress Info -->
    <div class="player-info">
        <div class="current-level">
            <span class="level-label">Current Level:</span>
            <span class="level-value" id="playerLevel">1</span>
        </div>
        <div class="premium-status" id="premiumStatus">
            <span class="status-label">Status:</span>
            <span class="status-value">Free Pass</span>
        </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="progress-container">
        <div class="progress-bar" id="progressBar" style="width: 2%;"></div>
        <div class="progress-text" id="progressText">Level 1 / 50</div>
    </div>
    
    <!-- Premium Pass Purchase Button -->
    <div style="text-align: center; margin-bottom: 2rem;">
        <button class="premium-button" id="purchasePremium">
             Unlock Premium Pass - 1000 digipogs
        </button>
    </div>
    
    <!-- Battle Pass Container -->
    <div class="battlepass-container">
        <button class="nav-arrow nav-arrow-left" id="navLeft" disabled>
            ◀
        </button>
        <div class="pass-track" id="passTrack">
            <!-- Tiers will be generated by JavaScript -->
        </div>
        <button class="nav-arrow nav-arrow-right" id="navRight">
            ▶
        </button>
    </div>
    <div class="pagination-info">
        <span id="pageInfo">Showing Tiers 1-10 of 50</span>
    </div>
    
    <script src="/js/theme.js"></script>
    <script>
        // Player data from server
        let playerLevel = <%= level || 1 %>; 
        let hasPremium = <%= user?.hasPaid ? 'true' : 'false' %>;
        let currentPage = 0;
        const tiersPerPage = 10; 
        
        // Battle pass rewards configuration
        const battlePassRewards = {
            free: {
                5: { name: "100 Coins", icon: "💰" },
                10: { name: "Profile Badge", icon: "🏅" },
                15: { name: "200 Coins", icon: "💰" },
                20: { name: "Card Back", icon: "🃏" },
                25: { name: "500 Coins", icon: "💰" },
                30: { name: "Emote", icon: "😎" },
                35: { name: "300 Coins", icon: "💰" },
                40: { name: "Title", icon: "👑" },
                45: { name: "1000 Coins", icon: "💰" },
                50: { name: "Legendary Card", icon: "⭐" }
            },
            premium: {
                1: { name: "Premium Badge", icon: "💎" },
                3: { name: "500 Coins", icon: "💰" },
                5: { name: "Exclusive Card", icon: "🎴" },
                7: { name: "300 Coins", icon: "💰" },
                10: { name: "Premium Avatar", icon: "👤" },
                12: { name: "700 Coins", icon: "💰" },
                15: { name: "Rare Card Pack", icon: "📦" },
                17: { name: "400 Coins", icon: "💰" },
                20: { name: "Premium Emote", icon: "😍" },
                22: { name: "600 Coins", icon: "💰" },
                25: { name: "Epic Card", icon: "🌟" },
                27: { name: "800 Coins", icon: "💰" },
                30: { name: "Premium Title", icon: "👑" },
                32: { name: "500 Coins", icon: "💰" },
                35: { name: "Epic Card Pack", icon: "📦" },
                37: { name: "1000 Coins", icon: "💰" },
                40: { name: "Premium Effect", icon: "✨" },
                42: { name: "700 Coins", icon: "💰" },
                45: { name: "Legendary Card", icon: "⭐" },
                47: { name: "1500 Coins", icon: "💰" },
                50: { name: "Ultimate Reward", icon: "🏆" }
            }
        };
        
        // Generate battle pass tiers
        function generateBattlePass(direction = null) {
            const passTrack = document.getElementById('passTrack');
            
            // If direction specified, animate out first
            if (direction) {
                const outClass = direction === 'right' ? 'slide-out-left' : 'slide-out-right';
                const inClass = direction === 'right' ? 'slide-in-right' : 'slide-in-left';
                
                passTrack.classList.add(outClass);
                
                setTimeout(() => {
                    passTrack.classList.remove(outClass);
                    renderTiers();
                    passTrack.classList.add(inClass);
                    
                    setTimeout(() => {
                        passTrack.classList.remove(inClass);
                    }, 400);
                }, 400);
            } else {
                renderTiers();
            }
        }
        
        function renderTiers() {
            const passTrack = document.getElementById('passTrack');
            passTrack.innerHTML = '';
            
            const startTier = currentPage * tiersPerPage + 1;
            const endTier = Math.min(startTier + tiersPerPage - 1, 50);
            
            for (let tier = startTier; tier <= endTier; tier++) {
                const tierDiv = document.createElement('div');
                tierDiv.className = 'tier';
                
                // Add unlocked class if player level is at or above this tier
                if (playerLevel >= tier) {
                    tierDiv.classList.add('unlocked');
                }
                
                // Tier number
                const tierNumber = document.createElement('div');
                tierNumber.className = 'tier-number';
                tierNumber.textContent = `Tier ${tier}`;
                tierDiv.appendChild(tierNumber);
                
                // Free reward
                const freeReward = battlePassRewards.free[tier];
                const freeRewardDiv = document.createElement('div');
                freeRewardDiv.className = 'tier-reward free-reward';
                freeRewardDiv.innerHTML = `
                    <div class="reward-label">Free</div>
                    ${freeReward ? `
                        <div class="reward-icon ${playerLevel >= tier ? 'unlocked' : ''}">${freeReward.icon}</div>
                        <div class="reward-name">${freeReward.name}</div>
                    ` : '<div class="no-reward">—</div>'}
                `;
                tierDiv.appendChild(freeRewardDiv);
                
                // Premium reward
                const premiumReward = battlePassRewards.premium[tier];
                const premiumRewardDiv = document.createElement('div');
                premiumRewardDiv.className = 'tier-reward premium-reward';
                
                if (premiumReward) {
                    const isUnlocked = hasPremium && playerLevel >= tier;
                    const isLocked = !hasPremium;
                    
                    premiumRewardDiv.innerHTML = `
                        <div class="reward-label premium">Premium</div>
                        <div class="reward-icon ${isUnlocked ? 'unlocked' : ''} ${isLocked ? 'locked' : ''}">${premiumReward.icon}${isLocked ? '🔒' : ''}</div>
                        <div class="reward-name">${premiumReward.name}</div>
                    `;
                    
                    if (hasPremium && playerLevel >= tier) {
                        tierDiv.classList.add('premium');
                    }
                } else {
                    premiumRewardDiv.innerHTML = '<div class="reward-label premium">Premium</div><div class="no-reward">—</div>';
                }
                
                tierDiv.appendChild(premiumRewardDiv);
                passTrack.appendChild(tierDiv);
            }
            
            updateNavigationButtons();
            updatePageInfo();
        }
        
        // Update navigation button states
        function updateNavigationButtons() {
            const navLeft = document.getElementById('navLeft');
            const navRight = document.getElementById('navRight');
            const totalPages = Math.ceil(50 / tiersPerPage);
            
            navLeft.disabled = currentPage === 0;
            navRight.disabled = currentPage >= totalPages - 1;
        }
        
        // Update pagination info
        function updatePageInfo() {
            const startTier = currentPage * tiersPerPage + 1;
            const endTier = Math.min(startTier + tiersPerPage - 1, 50);
            document.getElementById('pageInfo').textContent = `Showing Tiers ${startTier}-${endTier} of 50`;
        }
        
        // Navigation handlers
        document.getElementById('navLeft').addEventListener('click', function() {
            if (currentPage > 0) {
                currentPage--;
                generateBattlePass('left');
            }
        });
        
        document.getElementById('navRight').addEventListener('click', function() {
            const totalPages = Math.ceil(50 / tiersPerPage);
            if (currentPage < totalPages - 1) {
                currentPage++;
                generateBattlePass('right');
            }
        });
        
        // Update progress bar
        function updateProgress() {
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            const percentage = (playerLevel / 50) * 100;
            
            progressBar.style.width = percentage + '%';
            progressText.textContent = `Level ${playerLevel} / 50`;
            
            document.getElementById('playerLevel').textContent = playerLevel;
        }
        
        // Purchase premium handler
        document.getElementById('purchasePremium').addEventListener('click', function() {
            if (hasPremium) {
                alert('You already own the Premium Pass!');
                return;
            }
            
            if (confirm('Purchase Premium Battle Pass for 1000 digipogs?')) {
                fetch('/api/purchase-premium', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('Premium Pass unlocked!');
                        hasPremium = true;
                        document.getElementById('premiumStatus').querySelector('.status-value').textContent = 'Premium Pass ⭐';
                        document.getElementById('purchasePremium').textContent = '✅ Premium Pass Owned';
                        document.getElementById('purchasePremium').disabled = true;
                        generateBattlePass();
                    } else {
                        alert(data.message || 'Purchase failed. Please try again.');
                    }
                })
                .catch(err => {
                    console.error('Purchase error:', err);
                    alert('An error occurred. Please try again.');
                });
            }
        });
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Set premium status display
            if (hasPremium) {
                document.getElementById('premiumStatus').querySelector('.status-value').textContent = 'Premium Pass ⭐';
                document.getElementById('purchasePremium').textContent = '✅ Premium Pass Owned';
                document.getElementById('purchasePremium').disabled = true;
            }
            
            updateProgress();
            generateBattlePass();
        });
    </script>
</body>
</html>