            const audio = new Audio(soundPath);
            audio.volume = 0.5;
            audio.play().catch(err => console.log('Audio preview failed:', err));
        }

        function saveCustomSounds() {
            const customSounds = {};
            
            document.querySelectorAll('.custom-sound-select').forEach(select => {
                const soundType = select.getAttribute('data-sound-type');
                const soundPath = select.value;
                if (soundPath !== 'default') {
                    customSounds[soundType] = soundPath;
                }
            });
            
            // Save to localStorage
            localStorage.setItem('customSounds', JSON.stringify(customSounds));
            
            // Save custom sounds and set sound pack to 'custom'
            fetch('/api/update-custom-sounds', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customSounds: JSON.stringify(customSounds) })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Also update the sound pack to 'custom'
                    return fetch('/api/update-soundpack', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ soundPack: 'custom' })
                    });
                } else {
                    throw new Error(data.message || 'Failed to save custom sounds');
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    localStorage.setItem('selectedSoundPack', 'custom');
                    alert('Custom sound pack saved successfully!');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to save custom sounds');
                }
            })
            .catch(err => {
                console.error('Error saving custom sounds:', err);
                alert('An error occurred. Please try again.');
            });
        }

        // Badge customization functions
        const availableBadges = [
            { name: 'None', id: 'none', requirement: 'No badge', requiredLevel: 1, requiredWins: 0, unlocked: true, icon: '⚪' },
            { name: 'Bronze', id: 'bronze', requirement: 'Level 5 + 10 Wins', requiredLevel: 5, requiredWins: 10, unlocked: <%= (level || 1) >= 5 && (wins || 0) >= 10 ? 'true' : 'false' %>, icon: '🥉' },
            { name: 'Silver', id: 'silver', requirement: 'Level 15 + 25 Wins', requiredLevel: 15, requiredWins: 25, unlocked: <%= (level || 1) >= 15 && (wins || 0) >= 25 ? 'true' : 'false' %>, icon: '🥈' },
            { name: 'Gold', id: 'gold', requirement: 'Level 30 + 50 Wins', requiredLevel: 30, requiredWins: 50, unlocked: <%= (level || 1) >= 30 && (wins || 0) >= 50 ? 'true' : 'false' %>, icon: '🥇' },
            { name: 'Trophy', id: 'trophy', requirement: 'Level 45 + 100 Wins', requiredLevel: 45, requiredWins: 100, unlocked: <%= (level || 1) >= 45 && (wins || 0) >= 100 ? 'true' : 'false' %>, icon: '🏆' },
            { name: 'Premium Diamond', id: 'diamond', requirement: 'Purchase Battle Pass Premium', requiredLevel: 1, requiredWins: 0, unlocked: <%= hasBattlePassPremium ? 'true' : 'false' %>, icon: '💎' }
        ];

        function loadBadgeOptions() {
            const grid = document.getElementById('badgeGrid');
            grid.innerHTML = '';
            const currentBadge = '<%= selectedBadge %>';

            availableBadges.forEach(badge => {
                const badgeDiv = document.createElement('div');
                badgeDiv.className = `customization-item ${badge.unlocked ? 'unlocked' : 'locked'}`;
                
                if (badge.unlocked && badge.id === currentBadge) {
                    badgeDiv.classList.add('selected');
                }
                
                const iconOrImage = badge.image 
                    ? `<img src="/img/${badge.image}" alt="${badge.name}" class="customization-item-image" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'customization-item-icon\\'>${badge.icon}</div>';">`
                    : `<div class="customization-item-icon">${badge.icon}</div>`;
                
                badgeDiv.innerHTML = `
                    <div class="customization-item-content">
                        ${iconOrImage}
                        <div class="customization-item-name">${badge.name}</div>
                        ${!badge.unlocked ? `<div class="customization-item-lock">🔒</div>` : ''}
                        ${!badge.unlocked ? `<div class="customization-item-requirement">${badge.requirement}</div>` : ''}
                        ${badge.unlocked ? '<button class="customization-select-btn" onclick="selectBadge(\'' + badge.id + '\')">Select</button>' : ''}
                    </div>
                `;
                
                grid.appendChild(badgeDiv);
            });
        }

        function selectBadge(badge) {
            fetch('/api/update-badge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ badge })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Failed to update badge');
                }
            })
            .catch(err => {
                console.error('Error updating badge:', err);
                alert('An error occurred. Please try again.');
            });
        }

        // Emote customization functions
        const availableEmotes = [
            { name: 'Wave', id: 'wave', requirement: 'Starting Emote', requiredLevel: 1, unlocked: true, icon: '👋' },
            { name: 'Thumbs Up', id: 'thumbsup', requirement: 'Battle Pass Level 5', requiredLevel: 5, unlocked: <%= (level || 1) >= 5 ? 'true' : 'false' %>, icon: '👍' },
            { name: 'Party', id: 'party', requirement: 'Battle Pass Level 15', requiredLevel: 15, unlocked: <%= (level || 1) >= 15 ? 'true' : 'false' %>, icon: '🎉' },
            { name: 'Fire', id: 'fire', requirement: 'Battle Pass Level 20', requiredLevel: 20, unlocked: <%= (level || 1) >= 20 ? 'true' : 'false' %>, icon: '🔥' },
            { name: 'Heart Eyes', id: 'hearteyes', requirement: 'Battle Pass Level 20', requiredLevel: 20, unlocked: <%= (level || 1) >= 20 ? 'true' : 'false' %>, icon: '😍' },
            { name: 'Crown', id: 'crown', requirement: 'Battle Pass Level 30', requiredLevel: 30, unlocked: <%= (level || 1) >= 30 ? 'true' : 'false' %>, icon: '👑' },
            { name: 'Cool', id: 'cool', requirement: 'Battle Pass Level 30', requiredLevel: 30, unlocked: <%= (level || 1) >= 30 ? 'true' : 'false' %>, icon: '😎' },
            { name: 'Party Smith', id: 'partysmith', requirement: 'Battle Pass Level 35', requiredLevel: 35, unlocked: <%= (level || 1) >= 35 ? 'true' : 'false' %>, image: 'partySmith.png' },
            { name: 'Cowboy', id: 'cowboy', requirement: 'Battle Pass Level 35', requiredLevel: 35, unlocked: <%= (level || 1) >= 35 ? 'true' : 'false' %>, icon: '🤠' },
            { name: 'Rocket', id: 'rocket', requirement: 'Battle Pass Level 40', requiredLevel: 40, unlocked: <%= (level || 1) >= 40 ? 'true' : 'false' %>, icon: '🚀' },
            { name: 'Star', id: 'star', requirement: 'Battle Pass Level 50', requiredLevel: 50, unlocked: <%= (level || 1) >= 50 ? 'true' : 'false' %>, icon: '⭐' },
            { name: 'Disasmithed', id: 'disasmithed', requirement: 'Win 75 Games', requiredLevel: 1, unlocked: <%= (wins || 0) >= 75 ? 'true' : 'false' %>, image: 'disasmithed.png' }
        ];

        // Track selected emojis (max 4)
        let selectedEmojis = [];
        try {
            const emotesData = '<%- typeof selectedEmotes !== "undefined" ? selectedEmotes : "[]" %>';
            selectedEmojis = JSON.parse(emotesData);
            if (!Array.isArray(selectedEmojis) || selectedEmojis.length === 0) {
                selectedEmojis = ['wave', 'thumbsup', 'party', 'fire'];
            }
        } catch (e) {
            console.error('Error parsing selected emotes:', e);
            selectedEmojis = ['wave', 'thumbsup', 'party', 'fire'];
        }

        function updateSelectedEmojisPreview() {
            const preview = document.getElementById('selectedEmojisPreview');
            if (!preview) return;
            
            preview.innerHTML = '<div style="font-weight: 600; margin-bottom: 10px;">Selected Emojis (' + selectedEmojis.length + '/4):</div>';
            const container = document.createElement('div');
            container.style.display = 'flex';
            container.style.gap = '10px';
            container.style.flexWrap = 'wrap';
            container.style.justifyContent = 'center';
            
            selectedEmojis.forEach(emojiId => {
                const emote = availableEmotes.find(e => e.id === emojiId);
                if (emote) {
                    const emojiDiv = document.createElement('div');
                    emojiDiv.style.cssText = 'background: var(--card-bg); padding: 10px 15px; border-radius: 10px; border: 2px solid var(--accent-color); font-size: 1.2rem;';
                    
                    if (emote.image) {
                        emojiDiv.innerHTML = `<img src="/img/${emote.image}" alt="${emote.name}" style="width: 40px; height: 40px; border-radius: 5px;">`;
                    } else {
                        emojiDiv.textContent = emote.icon;
                    }
                    container.appendChild(emojiDiv);
                }
            });
            
            preview.appendChild(container);
        }

        function loadEmoteOptions() {
            const grid = document.getElementById('emoteGrid');
            grid.innerHTML = '';

            availableEmotes.forEach(emote => {
                const emoteDiv = document.createElement('div');
                const isSelected = selectedEmojis.includes(emote.id);
                emoteDiv.className = `customization-item ${emote.unlocked ? 'unlocked' : 'locked'} ${isSelected ? 'selected' : ''}`;
                
                const iconOrImage = emote.image 
                    ? `<img src="/img/${emote.image}" alt="${emote.name}" class="customization-item-image" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'customization-item-icon\\'>${emote.icon}</div>';">`
                    : `<div class="customization-item-icon">${emote.icon}</div>`;
                
                emoteDiv.innerHTML = `
                    <div class="customization-item-content">
                        ${iconOrImage}
                        <div class="customization-item-name">${emote.name}</div>
                        ${!emote.unlocked ? `<div class="customization-item-lock">🔒</div>` : ''}
                        ${!emote.unlocked ? `<div class="customization-item-requirement">${emote.requirement}</div>` : ''}
                        ${emote.unlocked ? '<button class="customization-select-btn" onclick="toggleEmoteSelection(\'' + emote.id + '\')">' + (isSelected ? 'Selected ✓' : 'Select') + '</button>' : ''}
                    </div>
                `;
                
                grid.appendChild(emoteDiv);
            });
            
            updateSelectedEmojisPreview();
        }

        function toggleEmoteSelection(emojiId) {
            const index = selectedEmojis.indexOf(emojiId);
            
            if (index > -1) {
                // Remove from selection
                selectedEmojis.splice(index, 1);
            } else {
                // Add to selection if less than 4
                if (selectedEmojis.length < 4) {
                    selectedEmojis.push(emojiId);
                } else {
                    alert('You can only select up to 4 emojis. Deselect one first.');
                    return;
                }
            }
            
            loadEmoteOptions(); // Reload to update button states
        }

        function saveSelectedEmojis() {
            if (selectedEmojis.length !== 4) {
                alert('Please select exactly 4 emojis before saving.');
                return;
            }
            
            fetch('/api/update-emojis', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ emojis: selectedEmojis })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('Emojis updated successfully!');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to update emojis');
                }
            })
            .catch(err => {
                console.error('Error updating emojis:', err);
                alert('An error occurred. Please try again.');
            });
        }

        function selectEmote(emote) {
            // Legacy function for backward compatibility
            toggleEmoteSelection(emote);
        }

        // Effects customization functions
        function showEffectsPopup() {
            document.getElementById('effectsPopup').style.display = 'flex';
            loadEffectsOptions();
        }

        function hideEffectsPopup() {
            document.getElementById('effectsPopup').style.display = 'none';
        }

        const availableEffects = [
            { name: 'Confetti', id: 'confetti', requirement: 'Starting Effect', requiredLevel: 1, unlocked: true, icon: '🎊' },
            { name: 'Sparkles', id: 'sparkles', requirement: 'Battle Pass Level 20', requiredLevel: 20, unlocked: <%= (level || 1) >= 20 ? 'true' : 'false' %>, icon: '✨' },
            { name: 'Lightning', id: 'lightning', requirement: 'Battle Pass Level 26', requiredLevel: 26, unlocked: <%= (level || 1) >= 26 ? 'true' : 'false' %>, icon: '⚡' },
            { name: 'Skip', id: 'skip', requirement: 'Battle Pass Level 31', requiredLevel: 31, unlocked: <%= (level || 1) >= 31 ? 'true' : 'false' %>, icon: '⛔' },
            { name: 'Flames', id: 'flames', requirement: 'Battle Pass Level 40', requiredLevel: 40, unlocked: <%= (level || 1) >= 40 ? 'true' : 'false' %>, icon: '🔥' },
            { name: 'Bow N Arrow', id: 'bow', requirement: 'Battle Pass Level 41', requiredLevel: 41, unlocked: <%= (level || 1) >= 41 ? 'true' : 'false' %>, icon: '🏹' }
        ];

        let selectedEffects = [];
        try {
            const effectData = '<%- typeof selectedEffect !== "undefined" ? selectedEffect : "" %>';
            if (effectData) {
                selectedEffects = effectData.startsWith('[') ? JSON.parse(effectData) : [effectData];
            }
            if (!Array.isArray(selectedEffects) || selectedEffects.length === 0) {
                selectedEffects = ['confetti'];
            }
        } catch(e) {
            console.error('Error parsing selected effects:', e);
            selectedEffects = ['confetti'];
        }

        function updateSelectedEffectsPreview() {
            const preview = document.getElementById('selectedEffectsPreview');
            if (!preview) return;
            
            preview.innerHTML = '<div style="font-weight: 600; margin-bottom: 10px;">Selected Effects (' + selectedEffects.length + '):</div>';
            const container = document.createElement('div');
            container.style.display = 'flex';
            container.style.gap = '10px';
            container.style.flexWrap = 'wrap';
            container.style.justifyContent = 'center';
            
            selectedEffects.forEach(effectId => {
                const effect = availableEffects.find(e => e.id === effectId);
                if (effect) {
                    const effectDiv = document.createElement('div');
                    effectDiv.style.cssText = 'background: var(--card-bg); padding: 10px 15px; border-radius: 10px; border: 2px solid var(--accent-color); font-size: 1.2rem;';
                    effectDiv.textContent = effect.icon;
                    container.appendChild(effectDiv);
                }
            });
            
            preview.appendChild(container);
        }

        function loadEffectsOptions() {
            const grid = document.getElementById('effectsGrid');
            grid.innerHTML = '';

            availableEffects.forEach(effect => {
                const effectDiv = document.createElement('div');
                const isSelected = selectedEffects.includes(effect.id);
                effectDiv.className = `customization-item ${effect.unlocked ? 'unlocked' : 'locked'} ${isSelected ? 'selected' : ''}`;
                
                effectDiv.innerHTML = `
                    <div class="customization-item-content">
                        <div class="customization-item-icon">${effect.icon}</div>
                        <div class="customization-item-name">${effect.name}</div>
                        ${!effect.unlocked ? `<div class="customization-item-lock">🔒</div>` : ''}
                        ${!effect.unlocked ? `<div class="customization-item-requirement">${effect.requirement}</div>` : ''}
                        ${effect.unlocked ? `
                          <button class="customization-select-btn" onclick="toggleEffectSelection('${effect.id}')">${isSelected ? 'Selected ✓' : 'Select'}</button>
                          <button class="effect-preview-btn" onclick="previewEffect('${effect.id}')">▶ Preview</button>
                        ` : ''}
                    </div>
                `;
                
                grid.appendChild(effectDiv);
            });
            
            updateSelectedEffectsPreview();
        }

        function toggleEffectSelection(effectId) {
            const index = selectedEffects.indexOf(effectId);
            
            if (index > -1) {
                // Remove from selection
                selectedEffects.splice(index, 1);
            } else {
                // Add to selection
                selectedEffects.push(effectId);
            }
            
            loadEffectsOptions(); // Reload to update button states
        }

        function previewEffect(effectId) {
            // Clean up any lingering preview elements
            document.querySelectorAll(
                '.preview-confetti,.preview-sparkle,.preview-fire,.preview-skip,' +
                '.preview-lightning-bolt,.preview-lightning-flash,.preview-arrow'
            ).forEach(el => el.remove());

            if (effectId === 'confetti') {
                const colors = ['#ff0000','#00ff00','#0000ff','#ffff00','#ff00ff','#00ffff','#ff8800','#ff0088','#88ff00','#0088ff'];
                for (let i = 0; i < 120; i++) {
                    setTimeout(() => {
                        const c = document.createElement('div');
                        c.className = 'preview-confetti';
                        c.style.left = Math.random() * 100 + '%';
                        c.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                        c.style.animationDuration = (Math.random() * 2 + 2) + 's';
                        c.style.width = c.style.height = (Math.random() * 12 + 8) + 'px';
                        document.body.appendChild(c);
                        setTimeout(() => c.remove(), 4500);
                    }, Math.random() * 1500);
                }

            } else if (effectId === 'sparkles') {
                const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
                for (let i = 0; i < 50; i++) {
                    setTimeout(() => {
                        const s = document.createElement('div');
                        s.className = 'preview-sparkle';
                        const angle = Math.random() * Math.PI * 2;
                        const r = 20 + Math.random() * 60;
                        s.style.left = (cx + Math.cos(angle) * r) + 'px';
                        s.style.top  = (cy + Math.sin(angle) * r) + 'px';
                        const ma = Math.random() * Math.PI * 2;
                        const md = 60 + Math.random() * 100;
                        s.style.setProperty('--sx', (Math.cos(ma) * md) + 'px');
                        s.style.setProperty('--sy', (Math.sin(ma) * md - 40) + 'px');
                        s.style.animationDuration = (.7 + Math.random() * .8) + 's';
                        document.body.appendChild(s);
                        setTimeout(() => s.remove(), 1600);
                    }, i * 30);
                }

            } else if (effectId === 'lightning') {
                const flash = document.createElement('div');
                flash.className = 'preview-lightning-flash';
                document.body.appendChild(flash);
                setTimeout(() => flash.remove(), 600);

                const tx = window.innerWidth / 2, ty = window.innerHeight / 2;
                for (let b = 0; b < 3; b++) {
                    setTimeout(() => {
                        const bolt = document.createElement('div');
                        bolt.className = 'preview-lightning-bolt';
                        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                        svg.setAttribute('width', window.innerWidth);
                        svg.setAttribute('height', window.innerHeight);
                        svg.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;';
                        let startX = tx + (Math.random() - 0.5) * 200;
                        let pd = `M ${startX} 0`;
                        const segs = 8;
                        for (let j = 1; j <= segs; j++) {
                            const prog = j / segs;
                            startX = startX + (tx - startX) * 0.3 + (Math.random() - 0.5) * 50 * (1 - prog * 0.7);
                            pd += ` L ${startX} ${(ty / segs) * j}`;
                        }
                        pd += ` L ${tx} ${ty}`;
                        const mkPath = (stroke, width, opacity) => {
                            const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                            p.setAttribute('d', pd); p.setAttribute('stroke', stroke);
                            p.setAttribute('stroke-width', width); p.setAttribute('fill', 'none');
                            p.setAttribute('stroke-linecap', 'round'); p.setAttribute('opacity', opacity);
                            return p;
                        };
                        svg.appendChild(mkPath('#4d94ff', '12', '0.6'));
                        svg.appendChild(mkPath('#b3d9ff', '6', '1'));
                        svg.appendChild(mkPath('#ffffff', '3', '1'));
                        bolt.appendChild(svg);
                        document.body.appendChild(bolt);
                        setTimeout(() => bolt.remove(), 700);
                    }, b * 90);
                }

            } else if (effectId === 'skip') {
                const sym = document.createElement('div');
                sym.className = 'preview-skip';
                document.body.appendChild(sym);
                setTimeout(() => sym.remove(), 1400);

            } else if (effectId === 'flames') {
                const W = window.innerWidth, H = window.innerHeight;
                for (let i = 0; i < 50; i++) {
                    setTimeout(() => {
                        const f = document.createElement('div');
                        f.className = 'preview-fire';
                        const large = i < 10;
                        const sz = large ? (35 + Math.random() * 15) : (10 + Math.random() * 18);
                        f.style.width = sz + 'px';
                        f.style.height = (sz * 1.4) + 'px';
                        f.style.left = (Math.random() * W) + 'px';
                        f.style.top  = (H - sz) + 'px';
                        f.style.setProperty('--fx', ((Math.random() - 0.5) * 80) + 'px');
                        f.style.setProperty('--fy', (-(large ? (250 + Math.random() * 200) : (100 + Math.random() * 150))) + 'px');
                        f.style.animationDuration = (large ? 2 : 1.2 + Math.random() * 0.8) + 's';
                        document.body.appendChild(f);
                        setTimeout(() => f.remove(), 3200);
                    }, i * 60);
                }

            } else if (effectId === 'bow') {
                const W = window.innerWidth;
                for (let i = 0; i < 12; i++) {
                    setTimeout(() => {
                        const a = document.createElement('div');
                        a.className = 'preview-arrow';
                        a.style.left = (Math.random() * (W - 90)) + 'px';
                        a.style.top  = '-10px';
                        a.style.animationDuration = (.7 + Math.random() * .5) + 's';
                        document.body.appendChild(a);
                        setTimeout(() => a.remove(), 1600);
                    }, i * 80);
                }
            }
        }

        function saveSelectedEffects() {
            if (selectedEffects.length === 0) {
                alert('Please select at least one effect before saving.');
                return;
            }
            
            fetch('/api/update-effect', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ effects: selectedEffects })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('Effects updated successfully!');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to update effects');
                }
            })
            .catch(err => {
                console.error('Error updating effects:', err);
                alert('An error occurred. Please try again.');
            });
        }
    </script>
</body>
</html>